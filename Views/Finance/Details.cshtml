@model dynamic

@{
    ViewData["Title"] = "Chi tiết giao dịch";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản Trị - Tài Chính</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/dashboard.css" />
</head>
<body>
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-circle"> <img src="@(Url.Content("~/img/logolsc.png"))" class="logo-circle-img" /></div>
            <h5 class="mb-0">Admin</h5>
            <small>Life Skills Club</small>
        </div>

        <div class="sidebar-menu">
            <a href="@Url.Action("Index", "Dashboard")" class="menu-item" onclick="showSection('dashboard')">
                <i class="fas fa-home"></i>
                <span>Trang Chủ</span>
            </a>
            <a href="@Url.Action("Index", "Members")" class="menu-item" onclick="showSection('members')">
                <i class="fas fa-users"></i>
                <span>Thành Viên</span>
            </a>
            <a href="@Url.Action("Index", "Activities")" class="menu-item" onclick="showSection('activities')">
                <i class="fas fa-calendar-alt"></i>
                <span>Hoạt Động</span>
            </a>
            <a href="@Url.Action("Index", "Project")" class="menu-item" onclick="showSection('projects')">
                <i class="fas fa-project-diagram"></i>
                <span>Dự Án</span>
            </a>
            <a href="@Url.Action("Index", "Finance")" class="menu-item active" onclick="showSection('finance')">
                <i class="fas fa-wallet"></i>
                <span>Tài Chính</span>
            </a>
            <a href="@Url.Action("Index", "Reports")" class="menu-item" onclick="showSection('reports')">
                <i class="fas fa-chart-bar"></i>
                <span>Báo Cáo</span>
            </a>
            <a href="@Url.Action("Index", "Settings")" class="menu-item" onclick="showSection('settings')">
                <i class="fas fa-cog"></i>
                <span>Cài Đặt</span>
            </a>
            <a href="@Url.Action("Login", "Auth")" class="menu-item" onclick="logout()">
                <i class="fas fa-sign-out-alt"></i>
                <span>Đăng Xuất</span>
            </a>
        </div>
    </div>

    <div class="main-content" id="mainContent">
        <div class="top-header">
            <div>
                <button class="toggle-btn" onclick="toggleSidebar()">
                    <i class="fas fa-bars"></i>
                </button>
            </div>

            <div class="user-info">
                <div class="position-relative">
                    <i class="fas fa-bell" style="font-size: 22px; color: #667eea; cursor: pointer;"></i>
                </div>
                <div>
                    <div class="fw-bold">Admin</div>
                    <small class="text-muted">Quản trị viên</small>
                </div>
                <div class="user-avatar">
                    <i class="fas fa-user"></i>
                </div>
            </div>
        </div>

        <div class="dashboard-content container mt-4">
            <h2 class="mb-4"><i class="fas fa-info-circle me-2" style="color: var(--primary-color);"></i>Chi tiết giao dịch</h2>

            <div class="card">
                <div class="card-body">
                    <table class="table table-bordered">
                        <tr>
                            <th>Mã giao dịch</th>
                            <td>@Model.MaGd</td>
                        </tr>
                        <tr>
                            <th>Loại giao dịch</th>
                            <td>@Model.LoaiGd</td>
                        </tr>
                        <tr>
                            <th>Số tiền</th>
                            <td>@Model.SoTien.ToString("N0") VNĐ</td>
                        </tr>
                        <tr>
                            <th>Ngày giao dịch</th>
                            <td>@Model.NgayGd.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                        <tr>
                            <th>Nội dung</th>
                            <td>@Model.NoiDung</td>
                        </tr>
                        <tr>
                            <th>Người thực hiện</th>
                            <td>@Model.NguoiThucHienTen</td>
                        </tr>

                        @if (Model.LoaiGd == "Thu")
                        {
                            <tr>
                                <th>Nguồn thu</th>
                                <td>@Model.NguonTen</td>
                            </tr>
                        }

                        @if (Model.LoaiGd == "Chi")
                        {
                            <tr>
                                <th>Hoạt động</th>
                                <td>@Model.HoatDongTen</td>
                            </tr>
                        }
                    </table>

                    <h4>Chi tiết giao dịch</h4>
                    @if (Model.ChiTiet.Count == 0)
                    {
                        <p>Không có chi tiết.</p>
                    }
                    else
                    {
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Mã CT</th>
                                    <th>Nội dung</th>
                                    <th>Số tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ct in Model.ChiTiet)
                                {
                                    <tr>
                                        <td>@ct.MaCt</td>
                                        <td>@ct.NoiDung</td>
                                        <td>@ct.SoTien.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }

                    <a asp-action="Index" class="btn btn-secondary mt-3">Quay lại</a>
                </div>
            </div>

        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
    <script src="~/js/dashboard.js"></script>
</body>
</html>

