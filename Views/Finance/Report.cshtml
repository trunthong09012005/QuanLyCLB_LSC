@{
    ViewBag.Title = "Báo cáo Thu Chi";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản Trị - Báo Cáo Tài Chính</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/dashboard.css" />
</head>
<body>
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-circle">LSC</div>
            <h5 class="mb-0">Admin</h5>
            <small>Life Skills Club</small>
        </div>

        <div class="sidebar-menu">
            <a href="@Url.Action("Index", "Dashboard")" class="menu-item" onclick="showSection('dashboard')">
                <i class="fas fa-home"></i>
                <span>Trang Chủ</span>
            </a>
            <a href="@Url.Action("Index", "Members")" class="menu-item" onclick="showSection('members')">
                <i class="fas fa-users"></i>
                <span>Thành Viên</span>
            </a>
            <a href="@Url.Action("Index", "Activities")" class="menu-item" onclick="showSection('activities')">
                <i class="fas fa-calendar-alt"></i>
                <span>Hoạt Động</span>
            </a>
            <a href="@Url.Action("Index", "Project")" class="menu-item" onclick="showSection('projects')">
                <i class="fas fa-project-diagram"></i>
                <span>Dự Án</span>
            </a>
            <a href="@Url.Action("Index", "Finance")" class="menu-item active" onclick="showSection('finance')">
                <i class="fas fa-wallet"></i>
                <span>Tài Chính</span>
            </a>
            <a href="@Url.Action("Index", "Reports")" class="menu-item" onclick="showSection('reports')">
                <i class="fas fa-chart-bar"></i>
                <span>Báo Cáo</span>
            </a>
            <a href="@Url.Action("Index", "Settings")" class="menu-item" onclick="showSection('settings')">
                <i class="fas fa-cog"></i>
                <span>Cài Đặt</span>
            </a>
            <a href="@Url.Action("Login", "Auth")" class="menu-item" onclick="logout()">
                <i class="fas fa-sign-out-alt"></i>
                <span>Đăng Xuất</span>
            </a>
        </div>
    </div>

    <div class="main-content" id="mainContent">
        <div class="top-header">
            <div>
                <button class="toggle-btn" onclick="toggleSidebar()">
                    <i class="fas fa-bars"></i>
                </button>
            </div>

            <div class="user-info">
                <div class="position-relative">
                    <i class="fas fa-bell" style="font-size: 22px; color: #667eea; cursor: pointer;"></i>
                </div>
                <div>
                    <div class="fw-bold">Admin</div>
                    <small class="text-muted">Quản trị viên</small>
                </div>
                <div class="user-avatar">
                    <i class="fas fa-user"></i>
                </div>
            </div>
        </div>

        <div class="dashboard-content container mt-4">
            <h2 class="mb-4">
                <i class="fas fa-file-invoice-dollar me-2" style="color: var(--primary-color);"></i>
                Báo cáo Thu Chi
            </h2>

            <div class="card mb-4">
                <div class="card-body">
                    <div>
                        <p><strong>Tổng ngân sách:</strong> @ViewBag.TongNganSach?.ToString("N0")</p>
                        <p><strong>Tổng thu tháng này:</strong> @ViewBag.TongThuThang?.ToString("N0")</p>
                        <p><strong>Tổng chi tháng này:</strong> @ViewBag.TongChiThang?.ToString("N0")</p>
                        <p><strong>Chênh lệch tháng này:</strong> @ViewBag.ChenhLech?.ToString("N0")</p>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h5>Danh sách giao dịch</h5>
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>Mã GD</th>
                                    <th>Loại</th>
                                    <th>Số tiền</th>
                                    <th>Ngày</th>
                                    <th>Nội dung</th>
                                    <th>Người thực hiện</th>
                                    <th>Nguồn / Hoạt động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.DanhSachGiaoDich != null)
                                {
                                    foreach (var gd in ViewBag.DanhSachGiaoDich)
                                    {
                                        <tr>
                                            <td>@gd.MaGd</td>
                                            <td>@gd.LoaiGd</td>
                                            <td>@gd.SoTien.ToString("N0")</td>
                                            <td>@(gd.NgayGd?.ToString("dd/MM/yyyy") ?? "")</td>
                                            <td>@gd.NoiDung</td>
                                            <td>@gd.NguoiThucHienTen</td>
                                            <td>
                                                @if (gd.LoaiGd == "Thu")
                                                {
                                                    @(gd.NguonTen ?? "(Không có nguồn)")
                                                }
                                                else
                                                {
                                                    @(gd.HoatDongTen ?? "(Không có hoạt động)")
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center">Không có giao dịch</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <p class="mt-3">
                        <a href="@Url.Action("ExportExcel", "Finance")" class="btn btn-success">Xuất báo cáo (.xlsx)</a>
                        <a href="@Url.Action("Index", "Finance")" class="btn btn-secondary ms-2">Quay lại</a>
                    </p>
                </div>
            </div>

        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
    <script src="~/js/dashboard.js"></script>
</body>
</html>
