@model QuanLyCLB_LSC.Models.ThuChi

@{
    ViewData["Title"] = "Thêm giao dịch thu";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản Trị - Tài Chính</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/dashboard.css" />
</head>
<body>
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-circle"> <img src="@(Url.Content("~/img/logolsc.png"))" class="logo-circle-img" /></div>
            <h5 class="mb-0">Admin</h5>
            <small>Life Skills Club</small>
        </div>

        <div class="sidebar-menu">
            <a href="@Url.Action("Index", "Dashboard")" class="menu-item" onclick="showSection('dashboard')">
                <i class="fas fa-home"></i>
                <span>Trang Chủ</span>
            </a>
            <a href="@Url.Action("Index", "Members")" class="menu-item" onclick="showSection('members')">
                <i class="fas fa-users"></i>
                <span>Thành Viên</span>
            </a>
            <a href="@Url.Action("Index", "Activities")" class="menu-item" onclick="showSection('activities')">
                <i class="fas fa-calendar-alt"></i>
                <span>Hoạt Động</span>
            </a>
            <a href="@Url.Action("Index", "Project")" class="menu-item" onclick="showSection('projects')">
                <i class="fas fa-project-diagram"></i>
                <span>Dự Án</span>
            </a>
            <a href="@Url.Action("Index", "Finance")" class="menu-item active" onclick="showSection('finance')">
                <i class="fas fa-wallet"></i>
                <span>Tài Chính</span>
            </a>
            <a href="@Url.Action("Index", "Reports")" class="menu-item" onclick="showSection('reports')">
                <i class="fas fa-chart-bar"></i>
                <span>Báo Cáo</span>
            </a>
            <a href="@Url.Action("Index", "Settings")" class="menu-item" onclick="showSection('settings')">
                <i class="fas fa-cog"></i>
                <span>Cài Đặt</span>
            </a>
            <a href="@Url.Action("Login", "Auth")" class="menu-item" onclick="logout()">
                <i class="fas fa-sign-out-alt"></i>
                <span>Đăng Xuất</span>
            </a>
        </div>
    </div>

    <div class="main-content" id="mainContent">
        <div class="top-header">
            <div>
                <button class="toggle-btn" onclick="toggleSidebar()">
                    <i class="fas fa-bars"></i>
                </button>
            </div>

            <div class="user-info">
                <div class="position-relative">
                    <i class="fas fa-bell" style="font-size: 22px; color: #667eea; cursor: pointer;"></i>
                </div>
                <div>
                    <div class="fw-bold">Admin</div>
                    <small class="text-muted">Quản trị viên</small>
                </div>
                <div class="user-avatar">
                    <i class="fas fa-user"></i>
                </div>
            </div>
        </div>

        <div class="dashboard-content container mt-4">
            <h2 class="mb-4"><i class="fas fa-plus-circle me-2" style="color: var(--primary-color);"></i>Thêm giao dịch thu</h2>

            <div class="card">
                <div class="card-body">
                    <form asp-action="CreateIncome" method="post">
                        <div class="mb-3">
                            <label asp-for="SoTien" class="form-label">Số tiền</label>
                            <input asp-for="SoTien" class="form-control" />
                            <span asp-validation-for="SoTien" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NoiDung" class="form-label">Nội dung</label>
                            <textarea asp-for="NoiDung" class="form-control"></textarea>
                            <span asp-validation-for="NoiDung" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Nguồn thu</label>
                            <select asp-for="MaNguon" class="form-select" asp-items="@(new SelectList(ViewBag.NguonThus, "MaNguon", "TenNguon"))">
                                <option value="">-- Chọn nguồn thu --</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Người thực hiện</label>
                            <select asp-for="NguoiThucHien" class="form-select" asp-items="@(new SelectList(ViewBag.ThanhViens, "MaTv", "HoTen"))">
                                <option value="">-- Chọn người thực hiện --</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-primary">Lưu</button>
                        <a asp-action="Index" class="btn btn-secondary ms-2">Hủy</a>
                    </form>
                </div>
            </div>

        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
    <script src="~/js/dashboard.js"></script>
</body>
</html>
