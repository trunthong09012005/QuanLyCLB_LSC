@model dynamic

<div class="container-fluid p-3">
    <div class="d-flex justify-content-center">
        <div class="card shadow-sm" style="max-width:640px; width:100%;">
            <div class="card-body p-4">
                <h5 class="card-title mb-3"><i class="fas fa-info-circle me-2 text-primary"></i>Chi tiết giao dịch</h5>

                <table class="table table-borderless mb-3">
                    <tbody>
                        <tr>
                            <th style="width:40%">Mã giao dịch</th>
                            <td>@Model.MaGd</td>
                        </tr>
                        <tr>
                            <th>Loại giao dịch</th>
                            <td>@Model.LoaiGd</td>
                        </tr>
                        <tr>
                            <th>Số tiền</th>
                            <td>@(Model.SoTien.ToString("N0")) VNĐ</td>
                        </tr>
                        <tr>
                            <th>Ngày giao dịch</th>
                            <td>@(Model.NgayGd != null ? Model.NgayGd.ToString("dd/MM/yyyy HH:mm") : "")</td>
                        </tr>
                        <tr>
                            <th>Nội dung</th>
                            <td>@Model.NoiDung</td>
                        </tr>
                        <tr>
                            <th>Người thực hiện</th>
                            <td>@(Model.NguoiThucHienTen ?? "N/A")</td>
                        </tr>
                        @if (Model.LoaiGd == "Thu")
                        {
                            <tr>
                                <th>Nguồn thu</th>
                                <td>@(Model.NguonTen ?? "N/A")</td>
                            </tr>
                        }
                        @if (Model.LoaiGd == "Chi")
                        {
                            <tr>
                                <th>Hoạt động</th>
                                <td>@(Model.HoatDongTen ?? "N/A")</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <h6 class="mt-3">Chi tiết giao dịch</h6>
                @if (Model.ChiTiet == null || Model.ChiTiet.Count == 0)
                {
                    <p class="text-muted mb-0">Không có chi tiết.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush mt-2">
                        @foreach (var ct in Model.ChiTiet)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold">@ct.NoiDung</div>
                                    <small class="text-muted">Mã CT: @ct.MaCt</small>
                                </div>
                                <div class="fw-bold">@ct.SoTien.ToString("N0") VNĐ</div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
