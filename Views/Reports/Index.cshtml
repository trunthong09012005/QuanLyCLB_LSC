@model ReportStatisticsViewModel
@using QuanLyCLB_LSC.ViewModels
@{
    ViewData["Title"] = "Báo cáo - CLB Kỹ Năng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/dashboard.css" />
<link rel="stylesheet" href="~/css/reports-redesigned.css" />

<style>
    /* Unified table styling with Dashboard */
    .reports-container .table-responsive .table thead {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
    }
    
    .reports-container .table-responsive .table thead th {
        color: white !important;
        font-weight: 600 !important;
        padding: 15px !important;
        border: none !important;
    }
    
    .reports-container .table-responsive .table tbody tr {
        transition: all 0.3s ease;
    }
    
    .reports-container .table-responsive .table tbody tr:hover {
        background: #f8f9fa;
        transform: scale(1.01);
    }

    /* Remove underline and ensure full-card clickable */
    .stat-grid a.stat-card { text-decoration: none; color: inherit; display: block; }
    .stat-grid a.stat-card:focus, .stat-grid a.stat-card:hover { text-decoration: none; }
    .stat-card .stat-detail { font-size: 16px; font-weight: 600; color: #1f2937; margin-top: 8px; }
    .stat-card .stat-label { margin-top: 6px; color: #7f8c8d; }
    /* hide original numeric styles if present */
    .stat-card .stat-number { display: none; }
</style>

<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
         <div class="logo-circle"> <img src="@(Url.Content("~/img/logolsc.png"))" class="logo-circle-img" /></div>
        <h5 class="mb-0">Admin</h5>
        <small>Life Skills Club</small>
    </div>

    <div class="sidebar-menu">
        <a href="@Url.Action("Index", "Dashboard")" class="menu-item">
            <i class="fas fa-home"></i>
            <span>Trang Chủ</span>
        </a>
        <a href="@Url.Action("Index", "Members")" class="menu-item">
            <i class="fas fa-users"></i>
            <span>Thành Viên</span>
        </a>
        <a href="@Url.Action("Index", "Activities")" class="menu-item">
            <i class="fas fa-calendar-alt"></i>
            <span>Hoạt Động</span>
        </a>
        <a href="@Url.Action("Index", "Project")" class="menu-item">
            <i class="fas fa-project-diagram"></i>
            <span>Dự Án</span>
        </a>
        <a href="@Url.Action("Index", "Finance")" class="menu-item">
            <i class="fas fa-wallet"></i>
            <span>Tài Chính</span>
        </a>
        <a href="@Url.Action("Index", "Reports")" class="menu-item active">
            <i class="fas fa-chart-bar"></i>
            <span>Báo Cáo</span>
        </a>
        <a href="@Url.Action("Index", "Settings")" class="menu-item">
            <i class="fas fa-cog"></i>
            <span>Cài Đặt</span>
        </a>
        <a href="@Url.Action("Login", "Auth")" class="menu-item">
            <i class="fas fa-sign-out-alt"></i>
            <span>Đăng Xuất</span>
        </a>
    </div>
</div>

<div class="main-content" id="mainContent">
    <div class="top-header">
        <div>
            <button class="toggle-btn" onclick="toggleSidebar()">
                <i class="fas fa-bars"></i>
            </button>
        </div>

        <div class="user-info">
            <div class="position-relative">
                <i class="fas fa-bell" style="font-size: 22px; color: var(--report-accent); cursor: pointer;"></i>
                <span class="notification-badge">3</span>
            </div>
            <div>
                <div class="fw-bold">Quản trị viên</div>
                <small class="text-muted">Quản trị viên</small>
            </div>
            <div class="user-avatar">
                <i class="fas fa-user"></i>
            </div>
        </div>
    </div>

    <div class="dashboard-content reports-container">
        <!-- Header Section -->
        <div class="reports-header mb-4">
            <div>
                <h2><i class="fas fa-chart-column me-2" style="color: var(--report-accent);"></i>Báo Cáo Tổng Hợp Dự Án</h2>
                <p class="text-muted">Thống kê và biểu đồ tổng thể về các hoạt động của CLB</p>
            </div>
        </div>

        <!-- Statistics Cards - Unified with Dashboard -->
        <!-- Statistic buttons: each card is a link to the category details -->
        <div class="stat-grid mb-4">
            <a href="@Url.Action("CategoryDetails", "Reports", new { category = "members" })" class="stat-card blue" role="button">
                <div class="stat-icon"><i class="fas fa-users"></i></div>
                <div class="stat-detail">Thống kê chi tiết</div>
                <div class="stat-label">Thành viên</div>
            </a>

            <a href="@Url.Action("CategoryDetails", "Reports", new { category = "activities" })" class="stat-card green" role="button">
                <div class="stat-icon"><i class="fas fa-calendar-check"></i></div>
                <div class="stat-detail">Thống kê chi tiết</div>
                <div class="stat-label">Hoạt động</div>
            </a>

            <a href="@Url.Action("CategoryDetails", "Reports", new { category = "projects" })" class="stat-card orange" role="button">
                <div class="stat-icon"><i class="fas fa-project-diagram"></i></div>
                <div class="stat-detail">Thống kê chi tiết</div>
                <div class="stat-label">Dự án</div>
            </a>

            <a href="@Url.Action("CategoryDetails", "Reports", new { category = "finance" })" class="stat-card purple pulse" role="button">
                <div class="stat-icon"><i class="fas fa-wallet"></i></div>
                <div class="stat-detail">Thống kê chi tiết</div>
                <div class="stat-label">Tài chính</div>
            </a>
        </div>

        <!-- Controls Section -->
        <div class="report-card mb-4">
            <div class="controls-header">
                <h5>Tuỳ chọn và Bộ lọc</h5>
            </div>
            <div class="controls-content">
                <div class="row g-3">
                    <!-- Year Filter -->
                    <div class="col-md-3">
                        <label class="form-label">Chọn năm</label>
                        <select id="yearFilter" class="form-select" onchange="filterCharts()">
                            @{
                                for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 5; y--)
                                {
                                    if (y == (ViewBag.SelectedYear ?? DateTime.Now.Year))
                                    {
                                        <option value="@y" selected="selected">@y</option>
                                    }
                                    else
                                    {
                                        <option value="@y">@y</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <!-- Action Button -->
                    <div class="col-md-3 d-flex align-items-end">
                        <button class="btn btn-primary w-100" onclick="applyFilters()">
                            <i class="fas fa-filter me-2"></i>Áp dụng
                        </button>
                    </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts Section -->
        <div class="report-card mb-4">
            <div class="charts-header">
                <h5>Biểu Đồ Thống Kê</h5>
            </div>
            <div class="charts-grid">
                <div class="chart-item">
                    <div class="chart-title">Thành viên theo tháng</div>
                    <div class="chart-wrapper">
                        <canvas id="membersChart"></canvas>
                    </div>
                </div>
                <div class="chart-item">
                    <div class="chart-title">Hoạt động theo tháng</div>
                    <div class="chart-wrapper">
                        <canvas id="activitiesChart"></canvas>
                    </div>
                </div>
                <div class="chart-item">
                    <div class="chart-title">Phân bố dự án theo trạng thái</div>
                    <div class="chart-wrapper">
                        <canvas id="projectsChart"></canvas>
                    </div>
                </div>
                <div class="chart-item">
                    <div class="chart-title">Thu - Chi theo tháng</div>
                    <div class="chart-wrapper">
                        <canvas id="financeChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Data Container for JavaScript -->
<div id="reportData" style="display:none"
     data-members-labels='@Html.Raw(ViewBag.MembersChartLabels ?? "[]")'
     data-members-data='@Html.Raw(ViewBag.MembersChartData ?? "[]")'
     data-activities-labels='@Html.Raw(ViewBag.ActivitiesChartLabels ?? "[]")'
     data-activities-data='@Html.Raw(ViewBag.ActivitiesChartData ?? "[]")'
     data-projects-labels='@Html.Raw(ViewBag.ProjectsChartLabels ?? "[]")'
     data-projects-data='@Html.Raw(ViewBag.ProjectsChartData ?? "[]")'
     data-finance-labels='@Html.Raw(ViewBag.FinanceChartLabels ?? "[]")'
     data-finance-income='@Html.Raw(ViewBag.FinanceChartIncome ?? "[]")'
     data-finance-expense='@Html.Raw(ViewBag.FinanceChartExpense ?? "[]")'>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
    <script src="~/js/reports-redesigned.js"></script>
    <script src="~/js/dashboard.js"></script>
    <script>
        function exportFinancePdf() {
            const yearSelect = document.getElementById('yearFilter');
            const year = yearSelect ? yearSelect.value : (new Date()).getFullYear();
            const url = '@Url.Action("ExportFinancePdf", "Reports")';
            window.location.href = url + '?year=' + encodeURIComponent(year);
        }
    </script>
}
