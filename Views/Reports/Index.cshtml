@model ReportStatisticsViewModel
@using QuanLyCLB_LSC.ViewModels
@{
    ViewData["Title"] = "Báo cáo - CLB Kỹ Năng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/dashboard.css" />
<link rel="stylesheet" href="~/css/reports-redesigned.css" />

<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <div class="logo-circle">LSC</div>
        <h5 class="mb-0">Admin Panel</h5>
        <small>Life Skills Club</small>
    </div>

    <div class="sidebar-menu">
        <a href="@Url.Action("Index", "Dashboard")" class="menu-item">
            <i class="fas fa-home"></i>
            <span>Trang Chủ</span>
        </a>
        <a href="@Url.Action("Index", "Members")" class="menu-item">
            <i class="fas fa-users"></i>
            <span>Thành Viên</span>
        </a>
        <a href="@Url.Action("Index", "Activities")" class="menu-item">
            <i class="fas fa-calendar-alt"></i>
            <span>Hoạt Động</span>
        </a>
        <a href="@Url.Action("Index", "Project")" class="menu-item" onclick="showSection('projects')">
            <i class="fas fa-project-diagram"></i>
            <span>Dự Án</span>
        </a>
        <a href="@Url.Action("Index", "Finance")" class="menu-item" onclick="showSection('finance')">
            <i class="fas fa-wallet"></i>
            <span>Tài Chính</span>
        </a>
        <a href="@Url.Action("Index", "Reports")" class="menu-item active">
            <i class="fas fa-chart-bar"></i>
            <span>Báo Cáo</span>
        </a>
        <a href="@Url.Action("Index", "Settings")" class="menu-item">
            <i class="fas fa-cog"></i>
            <span>Cài Đặt</span>
        </a>
        <a href="@Url.Action("Login", "Auth")" class="menu-item">
            <i class="fas fa-sign-out-alt"></i>
            <span>Đăng Xuất</span>
        </a>
    </div>
</div>

<div class="main-content" id="mainContent">
    <div class="top-header">
        <div>
            <button class="toggle-btn" onclick="toggleSidebar()">
                <i class="fas fa-bars"></i>
            </button>
        </div>

        <div class="user-info">
            <div class="position-relative">
                <i class="fas fa-bell" style="font-size: 22px; color: var(--report-accent); cursor: pointer;"></i>
                <span class="notification-badge">3</span>
            </div>
            <div>
                <div class="fw-bold">Quản trị viên</div>
                <small class="text-muted">Quản trị viên</small>
            </div>
            <div class="user-avatar">
                <i class="fas fa-user"></i>
            </div>
        </div>
    </div>

    <div class="dashboard-content reports-container">
        <!-- Header Section -->
        <div class="reports-header mb-4">
            <div>
                <h2><i class="fas fa-chart-column me-2" style="color: var(--report-accent);"></i>Báo Cáo Tổng Hợp Dự Án</h2>
                <p class="text-muted">Thống kê và biểu đồ tổng thể về các hoạt động của CLB</p>
            </div>
        </div>

        <!-- Statistics Cards -->
        <div class="stat-grid mb-4">
            <div class="stat-box">
                <div class="num">@Model.TongBaoCao</div>
                <div class="label">Tổng báo cáo</div>
            </div>
            <div class="stat-box">
                <div class="num">@Model.BaoCaoThangNay</div>
                <div class="label">Báo cáo tháng này</div>
            </div>
            <div class="stat-box">
                <div class="num">@Model.BaoCaoNamNay</div>
                <div class="label">Báo cáo năm này</div>
            </div>
            <div class="stat-box pulse">
                <div class="num">@Model.DanhSachLoai.Count</div>
                <div class="label">Loại báo cáo</div>
            </div>
        </div>

        <!-- Controls Section -->
        <div class="report-card mb-4">
            <div class="controls-header">
                <h5>Tuỳ chọn và Bộ lọc</h5>
            </div>
            <div class="controls-content">
                <div class="row g-3">
                    <!-- Year Filter -->
                    <div class="col-md-3">
                        <label class="form-label">Chọn năm</label>
                        <select id="yearFilter" class="form-select" onchange="filterCharts()">
                            @{
                                for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 5; y--)
                                {
                                    if (y == (ViewBag.SelectedYear ?? DateTime.Now.Year))
                                    {
                                        <option value="@y" selected="selected">@y</option>
                                    }
                                    else
                                    {
                                        <option value="@y">@y</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <!-- Category Selector -->
                    <div class="col-md-6">
                        <label class="form-label">Xem chi tiết danh mục</label>
                        <select id="categoryFilter" class="form-select" onchange="viewCategory()">
                            <option value="">-- Chọn danh mục --</option>
                            <option value="members">Thành viên</option>
                            <option value="activities">Hoạt động</option>
                            <option value="projects">Dự án</option>
                            <option value="finance">Tài chính</option>
                        </select>
                    </div>

                    <!-- Action Button -->
                    <div class="col-md-3 d-flex align-items-end">
                        <button class="btn btn-primary w-100" onclick="applyFilters()">
                            <i class="fas fa-filter me-2"></i>Áp dụng
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts Section -->
        <div class="report-card mb-4">
            <div class="charts-header">
                <h5>Biểu Đồ Thống Kê</h5>
            </div>
            <div class="charts-grid">
                <div class="chart-item">
                    <div class="chart-title">Thành viên theo tháng</div>
                    <div class="chart-wrapper">
                        <canvas id="membersChart"></canvas>
                    </div>
                </div>
                <div class="chart-item">
                    <div class="chart-title">Hoạt động theo tháng</div>
                    <div class="chart-wrapper">
                        <canvas id="activitiesChart"></canvas>
                    </div>
                </div>
                <div class="chart-item">
                    <div class="chart-title">Phân bố dự án theo trạng thái</div>
                    <div class="chart-wrapper">
                        <canvas id="projectsChart"></canvas>
                    </div>
                </div>
                <div class="chart-item">
                    <div class="chart-title">Thu - Chi theo tháng</div>
                    <div class="chart-wrapper">
                        <canvas id="financeChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Data Container for JavaScript -->
<div id="reportData" style="display:none"
     data-members-labels='@Html.Raw(ViewBag.MembersChartLabels ?? "[]")'
     data-members-data='@Html.Raw(ViewBag.MembersChartData ?? "[]")'
     data-activities-labels='@Html.Raw(ViewBag.ActivitiesChartLabels ?? "[]")'
     data-activities-data='@Html.Raw(ViewBag.ActivitiesChartData ?? "[]")'
     data-projects-labels='@Html.Raw(ViewBag.ProjectsChartLabels ?? "[]")'
     data-projects-data='@Html.Raw(ViewBag.ProjectsChartData ?? "[]")'
     data-finance-labels='@Html.Raw(ViewBag.FinanceChartLabels ?? "[]")'
     data-finance-income='@Html.Raw(ViewBag.FinanceChartIncome ?? "[]")'
     data-finance-expense='@Html.Raw(ViewBag.FinanceChartExpense ?? "[]")'>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
    <script src="~/js/reports-redesigned.js"></script>
    <script src="~/js/dashboard.js"></script>
}
