@model CategoryDetailsViewModel
@using QuanLyCLB_LSC.ViewModels
@using QuanLyCLB_LSC.Models
@{
    ViewData["Title"] = "Chi tiết danh mục - Báo cáo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/dashboard.css" />
<link rel="stylesheet" href="~/css/reports-redesigned.css" />

<style>
    /* Unified table styling with Dashboard */
    .table-responsive .table thead {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
    }
    
    .table-responsive .table thead th {
        color: white !important;
        font-weight: 600 !important;
        padding: 15px !important;
        border: none !important;
    }
    
    .table-responsive .table tbody tr {
        transition: all 0.3s ease;
    }
    
    .table-responsive .table tbody tr:hover {
        background: #f8f9fa;
        transform: scale(1.01);
    }
</style>

<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
         <div class="logo-circle"> <img src="@(Url.Content("~/img/logolsc.png"))" class="logo-circle-img" /></div>
        <h5 class="mb-0">Admin</h5>
        <small>Life Skills Club</small>
    </div>

    <div class="sidebar-menu">
        <a href="@Url.Action("Index", "Dashboard")" class="menu-item">
            <i class="fas fa-home"></i>
            <span>Trang Chủ</span>
        </a>
        <a href="@Url.Action("Index", "Members")" class="menu-item">
            <i class="fas fa-users"></i>
            <span>Thành Viên</span>
        </a>
        <a href="@Url.Action("Index", "Activities")" class="menu-item">
            <i class="fas fa-calendar-alt"></i>
            <span>Hoạt Động</span>
        </a>
        <a href="@Url.Action("Index", "Projects")" class="menu-item">
            <i class="fas fa-project-diagram"></i>
            <span>Dự Án</span>
        </a>
        <a href="@Url.Action("Index", "Finance")" class="menu-item">
            <i class="fas fa-wallet"></i>
            <span>Tài Chính</span>
        </a>
        <a href="@Url.Action("Index", "Reports")" class="menu-item active">
            <i class="fas fa-chart-bar"></i>
            <span>Báo Cáo</span>
        </a>
        <a href="@Url.Action("Index", "Settings")" class="menu-item">
            <i class="fas fa-cog"></i>
            <span>Cài Đặt</span>
        </a>
        <a href="@Url.Action("Login", "Auth")" class="menu-item">
            <i class="fas fa-sign-out-alt"></i>
            <span>Đăng Xuất</span>
        </a>
    </div>
</div>

<div class="main-content" id="mainContent">
    <div class="top-header">
        <div>
            <button class="toggle-btn" onclick="toggleSidebar()">
                <i class="fas fa-bars"></i>
            </button>
        </div>

        <div class="user-info">
            <div class="position-relative">
                <i class="fas fa-bell" style="font-size: 22px; color: var(--report-accent); cursor: pointer;"></i>
                <span class="notification-badge">3</span>
            </div>
            <div>
                <div class="fw-bold">Quản trị viên</div>
                <small class="text-muted">Quản trị viên</small>
            </div>
            <div class="user-avatar">
                <i class="fas fa-user"></i>
            </div>
        </div>
    </div>

    <div class="dashboard-content reports-container">
        <!-- Header Section -->
        <div class="reports-header mb-4">
            <div>
                <a href="@Url.Action("Index", "Reports")" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-arrow-left me-2"></i>Quay lại
                </a>
            </div>
            <div>
                <h2>
                    <i class="fas fa-table me-2" style="color: var(--report-accent);"></i>
                    @GetCategoryTitle(Model.Category)
                </h2>
                <p class="text-muted">Hiển thị chi tiết tất cả thông tin về @GetCategoryTitle(Model.Category).ToLower()</p>
            </div>
        </div>

        <!-- Filter and Search Section -->
        <div class="report-card mb-4">
            <div class="controls-header">
                <h5>Tìm kiếm và Lọc</h5>
            </div>
            <div class="controls-content">
                <form id="filterForm" method="get" class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label">Tìm kiếm</label>
                        <input id="searchInput" type="text" name="search" class="form-control" placeholder="Nhập từ khóa..." value="@Model.Search" autocomplete="off" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Lọc theo trạng thái</label>
                        <select id="filterSelect" name="filterType" class="form-select">
                            <option value="">-- Tất cả --</option>
                            @{
                                List<string> filterOptions = new();
                                if (Model.Category == "members")
                                {
                                    filterOptions = new List<string> { "Hoạt động", "Nghỉ học" };
                                }
                                else if (Model.Category == "activities")
                                {
                                    filterOptions = new List<string> { "Đang chuẩn bị", "Đang thực hiện", "Hoàn thành", "Hủy bỏ" };
                                }
                                else if (Model.Category == "projects")
                                {
                                    filterOptions = new List<string> { "Đang thực hiện", "Hoàn thành", "Tạm dừng", "Hủy bỏ" };
                                }
                                else if (Model.Category == "finance")
                                {
                                    filterOptions = new List<string> { "Thu", "Chi" };
                                }

                                foreach (var option in filterOptions)
                                {
                                    if (option == Model.FilterType)
                                    {
                                        <option value="@option" selected="selected">@option</option>
                                    }
                                    else
                                    {
                                        <option value="@option">@option</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-3 d-flex align-items-end">
                        <button id="searchBtn" type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-search me-2"></i>Tìm kiếm
                        </button>
                    </div>
                    <!-- Export PDF button -->
                    <div class="col-md-3 d-flex align-items-end">
                        @if (Model.Category == "finance")
                        {
                            <select id="exportYear" class="form-select me-2" style="width:120px;">
                                @{ for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 5; y--) { <text><option value="@y">@y</option></text>; } }
                            </select>
                        }
                        <button type="button" class="btn btn-outline-primary w-100" onclick="exportCategoryPdf()">
                            <i class="fas fa-file-pdf me-2"></i>Xuất PDF
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Data Table Section -->
        <div id="dataTableCard" class="report-card">
            <div class="table-header">
                <h5>Danh sách (Tổng: @Model.TotalCount bản ghi)</h5>
            </div>

            @if (Model.Category == "members")
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th class="sortable" data-sort="matv" style="cursor:pointer;">
                                    Mã TV
                                    <span class="sort-indicator">@(ViewBag.SortBy == "matv" ? (ViewBag.SortDir == "asc" ? "▲" : "▼") : "")</span>
                                </th>
                                <th class="sortable" data-sort="hoten" style="cursor:pointer;">
                                    Họ tên
                                    <span class="sort-indicator">@(ViewBag.SortBy == "hoten" ? (ViewBag.SortDir == "asc" ? "▲" : "▼") : "")</span>
                                </th>
                                <th class="sortable" data-sort="email" style="cursor:pointer;">
                                    Email
                                    <span class="sort-indicator">@(ViewBag.SortBy == "email" ? (ViewBag.SortDir == "asc" ? "▲" : "▼") : "")</span>
                                </th>
                                <th>Số điện thoại</th>
                                <th>Lớp</th>
                                <th>Trạng thái</th>
                                <th class="sortable" data-sort="ngaythamgia" style="cursor:pointer;">
                                    Ngày tham gia
                                    <span class="sort-indicator">@(ViewBag.SortBy == "ngaythamgia" ? (ViewBag.SortDir == "asc" ? "▲" : "▼") : "")</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Members.Any())
                            {
                                @foreach (var member in Model.Members)
                                {
                                    <tr>
                                        <td><strong>@member.MaTv</strong></td>
                                        <td>@member.HoTen</td>
                                        <td>@member.Email</td>
                                        <td>@member.Sdt</td>
                                        <td>@member.Lop</td>
                                        <td>
                                            <span class="badge bg-@(member.TrangThai == "Hoạt động" ? "success" : "secondary")">
                                                @member.TrangThai
                                            </span>
                                        </td>
                                        <td>@member.NgayThamGia?.ToString("dd/MM/yyyy")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="7" class="text-center text-muted">Không có dữ liệu</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (Model.Category == "activities")
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th class="sortable" data-sort="mahd" style="cursor:pointer;">
                                    Mã HD
                                    <span class="sort-indicator">@(ViewBag.SortBy == "mahd" ? (ViewBag.SortDir == "asc" ? "▲" : "▼") : "")</span>
                                </th>
                                <th class="sortable" data-sort="tenhd" style="cursor:pointer;">
                                    Tên hoạt động
                                    <span class="sort-indicator">@(ViewBag.SortBy == "tenhd" ? (ViewBag.SortDir == "asc" ? "▲" : "▼") : "")</span>
                                </th>
                                <th>Địa điểm</th>
                                <th class="sortable" data-sort="ngaytochuc" style="cursor:pointer;">
                                    Ngày tổ chức
                                    <span class="sort-indicator">@(ViewBag.SortBy == "ngaytochuc" ? (ViewBag.SortDir == "asc" ? "▲" : "▼") : "")</span>
                                </th>
                                <th>Người phụ trách</th>
                                <th>Kinh phí</th>
                                <th class="sortable" data-sort="trangthai" style="cursor:pointer;">
                                    Trạng thái
                                    <span class="sort-indicator">@(ViewBag.SortBy == "trangthai" ? (ViewBag.SortDir == "asc" ? "▲" : "▼") : "")</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Activities.Any())
                            {
                                @foreach (var activity in Model.Activities)
                                {
                                    <tr>
                                        <td><strong>@activity.MaHd</strong></td>
                                        <td>@activity.TenHd</td>
                                        <td>@activity.DiaDiem</td>
                                        <td>@activity.NgayToChuc?.ToString("dd/MM/yyyy")</td>
                                        <td>@activity.NguoiPhuTrachNavigation?.HoTen</td>
                                        <td>@activity.KinhPhiDuKien?.ToString("N0") ₫</td>
                                        <td>
                                            <span class="badge bg-@GetActivityStatusColor(activity.TrangThai)">
                                                @activity.TrangThai
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="7" class="text-center text-muted">Không có dữ liệu</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (Model.Category == "projects")
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th class="sortable" data-sort="mada" style="cursor:pointer;">
                                    Mã DA
                                    <span class="sort-indicator">@(ViewBag.SortBy == "mada" ? (ViewBag.SortDir == "asc" ? "▲" : "▼") : "")</span>
                                </th>
                                <th class="sortable" data-sort="tenduan" style="cursor:pointer;">
                                    Tên dự án
                                    <span class="sort-indicator">@(ViewBag.SortBy == "tenduan" ? (ViewBag.SortDir == "asc" ? "▲" : "▼") : "")</span>
                                </th>
                                <th>Mô tả</th>
                                <th class="sortable" data-sort="ngaybatdau" style="cursor:pointer;">
                                    Ngày bắt đầu
                                    <span class="sort-indicator">@(ViewBag.SortBy == "ngaybatdau" ? (ViewBag.SortDir == "asc" ? "▲" : "▼") : "")</span>
                                </th>
                                <th class="sortable" data-sort="ngayketthuc" style="cursor:pointer;">
                                    Ngày kết thúc
                                    <span class="sort-indicator">@(ViewBag.SortBy == "ngayketthuc" ? (ViewBag.SortDir == "asc" ? "▲" : "▼") : "")</span>
                                </th>
                                <th class="sortable" data-sort="trangthai" style="cursor:pointer;">
                                    Trạng thái
                                    <span class="sort-indicator">@(ViewBag.SortBy == "trangthai" ? (ViewBag.SortDir == "asc" ? "▲" : "▼") : "")</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Projects.Any())
                            {
                                @foreach (var project in Model.Projects)
                                {
                                    <tr>
                                        <td><strong>@project.MaDa</strong></td>
                                        <td>@project.TenDuAn</td>
                                        <td>@(project.MoTa?.Length > 50 ? project.MoTa.Substring(0, 50) + "..." : project.MoTa)</td>
                                        <td>@project.NgayBatDau?.ToString("dd/MM/yyyy")</td>
                                        <td>@project.NgayKetThuc?.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <span class="badge bg-@GetProjectStatusColor(project.TrangThai)">
                                                @project.TrangThai
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="6" class="text-center text-muted">Không có dữ liệu</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (Model.Category == "finance")
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th class="sortable" data-sort="magd" style="cursor:pointer;">
                                    Mã GD
                                    <span class="sort-indicator">@(ViewBag.SortBy == "magd" ? (ViewBag.SortDir == "asc" ? "▲" : "▼") : "")</span>
                                </th>
                                <th>Loại giao dịch</th>
                                <th class="sortable" data-sort="sotien" style="cursor:pointer;">
                                    Số tiền
                                    <span class="sort-indicator">@(ViewBag.SortBy == "sotien" ? (ViewBag.SortDir == "asc" ? "▲" : "▼") : "")</span>
                                </th>
                                <th>Nội dung</th>
                                <th class="sortable" data-sort="ngaygd" style="cursor:pointer;">
                                    Ngày giao dịch
                                    <span class="sort-indicator">@(ViewBag.SortBy == "ngaygd" ? (ViewBag.SortDir == "asc" ? "▲" : "▼") : "")</span>
                                </th>
                                <th>Người thực hiện</th>
                                <th>Nguồn</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ThuChis.Any())
                            {
                                @foreach (var transaction in Model.ThuChis)
                                {
                                    <tr>
                                        <td><strong>@transaction.MaGd</strong></td>
                                        <td>
                                            <span class="badge bg-@(transaction.LoaiGd == "Thu" ? "success" : "danger")">
                                                @transaction.LoaiGd
                                            </span>
                                        </td>
                                        <td class="fw-bold">@transaction.SoTien.ToString("N0") ₫</td>
                                        <td>@(transaction.NoiDung?.Length > 40 ? transaction.NoiDung.Substring(0, 40) + "..." : transaction.NoiDung)</td>
                                        <td>@transaction.NgayGd?.ToString("dd/MM/yyyy")</td>
                                        <td>@transaction.NguoiThucHienNavigation?.HoTen</td>
                                        <td>@transaction.MaNguonNavigation?.TenNguon</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="7" class="text-center text-muted">Không có dữ liệu</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <nav class="mt-4">
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            string queryString = $"?category={Model.Category}&page={i}";
                            if (!string.IsNullOrWhiteSpace(Model.Search))
                                queryString += $"&search={Uri.EscapeDataString(Model.Search)}";
                            if (!string.IsNullOrWhiteSpace(Model.FilterType))
                                queryString += $"&filterType={Model.FilterType}";

                            <li class="page-item @(i == Model.Page ? "active" : "")">
                                <a class="page-link" href="@Url.Action("CategoryDetails", "Reports")@queryString">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js"></script>
    <script>
        // Debounce helper
        function debounce(fn, delay) {
            let t;
            return function(...args) {
                clearTimeout(t);
                t = setTimeout(() => fn.apply(this, args), delay);
            };
        }

        (function() {
            const category = '@Model.Category';
            const searchInput = document.getElementById('searchInput');
            const filterSelect = document.getElementById('filterSelect');
            const filterForm = document.getElementById('filterForm');
            const dataCard = document.getElementById('dataTableCard');
            const exportYear = document.getElementById('exportYear');

            // Prevent full form submit — we handle via AJAX
            filterForm.addEventListener('submit', function(e) {
                e.preventDefault();
            });

            // Build URL for fetching filtered content
            function buildUrl(params) {
                const url = new URL(window.location.origin + '/Reports/CategoryDetails');
                url.searchParams.set('category', category);
                if (params.search) url.searchParams.set('search', params.search);
                if (params.filterType) url.searchParams.set('filterType', params.filterType);
                if (currentSortBy) url.searchParams.set('sortBy', currentSortBy);
                if (currentSortDir) url.searchParams.set('sortDir', currentSortDir);
                url.searchParams.set('page', '1');
                return url.toString();
            }

            let currentRequest = 0;
            async function fetchData() {
                const reqId = ++currentRequest;
                const params = {
                    search: searchInput ? searchInput.value.trim() : '',
                    filterType: filterSelect ? filterSelect.value : ''
                };

                const url = buildUrl(params);
                try {
                    const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (!res.ok) throw new Error('Network response was not ok');
                    const text = await res.text();
                    // Only apply if this is the latest request
                    if (reqId !== currentRequest) return;

                    // Parse returned HTML and replace data table card
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(text, 'text/html');
                    const newCard = doc.getElementById('dataTableCard');
                    if (newCard && dataCard) {
                        dataCard.innerHTML = newCard.innerHTML;
                    } else {
                        // fallback: replace entire container
                        const main = doc.querySelector('.reports-container');
                        const currentMain = document.querySelector('.reports-container');
                        if (main && currentMain) currentMain.innerHTML = main.innerHTML;
                    }
                    // update URL in address bar (without reloading)
                    const newUrlParams = new URLSearchParams();
                    if (params.search) newUrlParams.set('search', params.search);
                    if (params.filterType) newUrlParams.set('filterType', params.filterType);
                    if (currentSortBy) newUrlParams.set('sortBy', currentSortBy);
                    if (currentSortDir) newUrlParams.set('sortDir', currentSortDir);
                    newUrlParams.set('category', category);
                    history.replaceState(null, '', '/Reports/CategoryDetails?' + newUrlParams.toString());
                } catch (err) {
                    console.error('Error fetching filtered data', err);
                }
            }

            const debouncedFetch = debounce(fetchData, 300);

            // Sorting state initialized from server
            let currentSortBy = '@(ViewBag.SortBy ?? "")';
            let currentSortDir = '@(ViewBag.SortDir ?? "")';

            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    debouncedFetch();
                });
            }

            if (filterSelect) {
                filterSelect.addEventListener('change', function() {
                    fetchData();
                });
            }

            // Handle clicks on sort buttons via event delegation
            if (dataCard) {
                dataCard.addEventListener('click', function(e) {
                    const th = e.target.closest('th.sortable');
                    if (!th) return;
                    e.preventDefault();
                    const sortKey = th.getAttribute('data-sort');
                    if (!sortKey) return;
                    if (currentSortBy === sortKey) {
                        // toggle
                        currentSortDir = (currentSortDir === 'asc') ? 'desc' : 'asc';
                    } else {
                        currentSortBy = sortKey;
                        currentSortDir = 'asc';
                    }
                    // perform fetch with new sort
                    fetchData();
                });
            }

            // Export function uses current filters
            window.exportCategoryPdf = function() {
                const params = new URLSearchParams();
                if (searchInput && searchInput.value) params.append('search', searchInput.value.trim());
                if (filterSelect && filterSelect.value) params.append('filterType', filterSelect.value);
                if (currentSortBy) params.append('sortBy', currentSortBy);
                if (currentSortDir) params.append('sortDir', currentSortDir);
                if (category === 'finance') {
                    const year = exportYear ? exportYear.value : (new Date()).getFullYear();
                    params.append('year', year);
                }
                const url = '/Reports/ExportCategoryPdf?category=' + encodeURIComponent(category) + '&' + params.toString();
                window.location.href = url;
            };
        })();
    </script>
 }

@functions {
    private string GetCategoryTitle(string category) => category?.ToLower() switch
    {
        "members" => "Thành viên",
        "activities" => "Hoạt động",
        "projects" => "Dự án",
        "finance" => "Tài chính",
        _ => "Danh mục"
    };

    private string GetActivityStatusColor(string status) => status switch
    {
        "Đang chuẩn bị" => "info",
        "Đang thực hiện" => "primary",
        "Hoàn thành" => "success",
        "Hủy bỏ" => "danger",
        _ => "secondary"
    };

    private string GetProjectStatusColor(string status) => status switch
    {
        "Đang thực hiện" => "primary",
        "Hoàn thành" => "success",
        "Tạm dừng" => "warning",
        "Hủy bỏ" => "danger",
        _ => "secondary"
    };
}
