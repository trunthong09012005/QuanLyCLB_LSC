@model QuanLyCLB_LSC.ViewModels.UserDashboardViewModel
@{
    ViewData["Title"] = "Dashboard - CLB Kỹ Năng X LSC";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Member Dashboard - CLB Lập Trình LSC</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/css/user.css" />
</head>
<body class="bg-gray-50">
    <!-- Navigation Bar -->
    <nav class="bg-white shadow-sm border-b sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center space-x-8">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-gradient-to-br from-blue-600 to-indigo-600 rounded-lg flex items-center justify-center text-white font-bold shadow-md">
                            LSC
                        </div>
                        <span class="text-xl font-bold text-gray-800">CLB Kỹ Năng X LSC</span>
                    </div>

                    <div class="hidden md:flex space-x-1">
                        <button onclick="showTab('home')" class="tab-button active px-4 py-2 rounded-lg font-medium" id="tab-home">
                            🏠 Trang chủ
                        </button>
                        <button onclick="showTab('timeline')" class="tab-button px-4 py-2 rounded-lg font-medium text-gray-600 hover:bg-gray-50" id="tab-timeline">
                            ⏱️ Timeline
                        </button>
                        <button onclick="showTab('awards')" class="tab-button px-4 py-2 rounded-lg font-medium text-gray-600 hover:bg-gray-50" id="tab-awards">
                            🏆 Khen thưởng
                        </button>
                    </div>

                </div>

                <div class="flex items-center space-x-4">
                    <button class="bell-button p-2 hover:bg-gray-100 rounded-lg transition-colors relative"
                            onclick="handleNotificationClick()"
                            title="Xem thông báo mới">
                        🔔
                        @if (Model.CoTimelineMoi)   
                        {
                            <span class="notification-dot absolute top-0 right-0 w-3 h-3 bg-red-500 rounded-full"></span>
                        }
                    </button>

                    <div class="flex items-center space-x-3 pl-4 border-l">
                        <div>
                            <p class="text-sm font-semibold text-gray-800 text-right">@Model.HoTen</p>
                            <p class="text-xs text-gray-500 text-right">@Model.TenChucVu</p>
                        </div>
                        <!-- Avatar -->
                        <!-- Avatar -->
                        <div class="relative">
                            <div id="avatarLogout" class="w-10 h-10 bg-gradient-to-br from-blue-500 to-indigo-500
         rounded-full flex items-center justify-center text-white
         font-semibold shadow-md cursor-pointer">
                                @Model.HoTen?.Substring(0, 1).ToUpper()
                            </div>

                            <!-- Dropdown menu -->
                            <div id="avatarMenu" class="absolute right-0 mt-2 w-40 bg-white border rounded-lg shadow-lg hidden z-50">
                                <button id="logoutBtn" class="w-full text-left px-4 py-2 hover:bg-gray-100">Đăng xuất</button>
                                <button id="cancelBtn" class="w-full text-left px-4 py-2 hover:bg-gray-100">Hủy</button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 py-8 sm:px-6 lg:px-8">
        <!-- HOME TAB -->
        <div id="content-home" class="tab-content">
            <!-- Hero Section -->
            <div class="bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 rounded-3xl shadow-2xl overflow-hidden mb-8">
                <div class="px-8 py-12 md:py-16">
                    <div class="max-w-3xl">
                        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
                            Chào mừng trở lại, @(Model.HoTen?.Split(' ').LastOrDefault())! 👋
                        </h1>
                        <p class="text-xl text-blue-100 mb-6">
                            Cùng nhau xây dựng cộng đồng lập trình viên mạnh mẽ và năng động
                        </p>
                        <div class="flex flex-wrap gap-4">
                            <div class="bg-white/20 backdrop-blur-sm px-6 py-3 rounded-xl">
                                <p class="text-white/80 text-sm">Thành viên từ</p>
                                <p class="text-white font-bold text-lg">@Model.NgayThamGia?.ToString("dd/MM/yyyy")</p>
                            </div>
                            <div class="bg-white/20 backdrop-blur-sm px-6 py-3 rounded-xl">
                                <p class="text-white/80 text-sm">Điểm rèn luyện</p>
                                <p class="text-white font-bold text-lg">@(Model.DiemRenLuyen ?? 0)/100</p>
                            </div>
                            <div class="bg-white/20 backdrop-blur-sm px-6 py-3 rounded-xl">
                                <p class="text-white/80 text-sm">Giải thưởng</p>
                                <p class="text-white font-bold text-lg">@Model.SoGiaiThuong</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stats Grid -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
                <div class="bg-white rounded-2xl shadow-md p-6 hover:shadow-lg transition-shadow">
                    <div class="flex items-center justify-between mb-3">
                        <div class="p-3 bg-blue-100 rounded-xl text-2xl">👥</div>
                    </div>
                    <p class="text-3xl font-bold text-gray-800">@Model.TongThanhVien</p>
                    <p class="text-sm text-gray-500 mt-1">Thành viên</p>
                </div>
                <div class="bg-white rounded-2xl shadow-md p-6 hover:shadow-lg transition-shadow">
                    <div class="flex items-center justify-between mb-3">
                        <div class="p-3 bg-green-100 rounded-xl text-2xl">📅</div>
                    </div>
                    <p class="text-3xl font-bold text-gray-800">@Model.TongSuKien</p>
                    <p class="text-sm text-gray-500 mt-1">Sự kiện</p>
                </div>
                <div class="bg-white rounded-2xl shadow-md p-6 hover:shadow-lg transition-shadow">
                    <div class="flex items-center justify-between mb-3">
                        <div class="p-3 bg-purple-100 rounded-xl text-2xl">📋</div>
                    </div>
                    <p class="text-3xl font-bold text-gray-800">@Model.TongDuAn</p>
                    <p class="text-sm text-gray-500 mt-1">Dự án</p>
                </div>
                <div class="bg-white rounded-2xl shadow-md p-6 hover:shadow-lg transition-shadow">
                    <div class="flex items-center justify-between mb-3">
                        <div class="p-3 bg-yellow-100 rounded-xl text-2xl">🏆</div>
                    </div>
                    <p class="text-3xl font-bold text-gray-800">@Model.SoGiaiThuong</p>
                    <p class="text-sm text-gray-500 mt-1">Giải thưởng</p>
                </div>
            </div>

            <!-- Member Info Card -->
            <div class="bg-white rounded-2xl shadow-md overflow-hidden mb-8">
                <div class="bg-gradient-to-r from-blue-600 to-indigo-600 px-6 py-4">
                    <h2 class="text-xl font-bold text-white">Thông tin cá nhân</h2>
                </div>
                <div class="p-6">
                    <div class="grid md:grid-cols-2 gap-6">
                        <div class="space-y-4">
                            <div class="flex items-start space-x-3">
                                <span class="text-2xl">👤</span>
                                <div>
                                    <p class="text-sm text-gray-500">Họ và tên</p>
                                    <p class="font-semibold text-gray-800">@Model.HoTen</p>
                                </div>
                            </div>
                            <div class="flex items-start space-x-3">
                                <span class="text-2xl">📅</span>
                                <div>
                                    <p class="text-sm text-gray-500">Ngày sinh</p>
                                    <p class="font-semibold text-gray-800">@Model.NgaySinh?.ToString("dd/MM/yyyy")</p>
                                </div>
                            </div>
                            <div class="flex items-start space-x-3">
                                <span class="text-2xl">📧</span>
                                <div>
                                    <p class="text-sm text-gray-500">Email</p>
                                    <p class="font-semibold text-gray-800">@Model.Email</p>
                                </div>
                            </div>
                            <div class="flex items-start space-x-3">
                                <span class="text-2xl">📱</span>
                                <div>
                                    <p class="text-sm text-gray-500">Số điện thoại</p>
                                    <p class="font-semibold text-gray-800">@Model.SDT</p>
                                </div>
                            </div>
                        </div>
                        <div class="space-y-4">
                            <div class="flex items-start space-x-3">
                                <span class="text-2xl">📚</span>
                                <div>
                                    <p class="text-sm text-gray-500">Lớp</p>
                                    <p class="font-semibold text-gray-800">@Model.Lop</p>
                                </div>
                            </div>
                            <div class="flex items-start space-x-3">
                                <span class="text-2xl">🎓</span>
                                <div>
                                    <p class="text-sm text-gray-500">Khoa</p>
                                    <p class="font-semibold text-gray-800">@Model.Khoa</p>
                                </div>
                            </div>
                            <div class="flex items-start space-x-3">
                                <span class="text-2xl">⭐</span>
                                <div>
                                    <p class="text-sm text-gray-500">Chức vụ</p>
                                    <p class="font-semibold text-gray-800">@Model.TenChucVu</p>
                                </div>
                            </div>
                            <div class="flex items-start space-x-3">
                                <span class="text-2xl">👥</span>
                                <div>
                                    <p class="text-sm text-gray-500">Ban chuyên môn</p>
                                    <p class="font-semibold text-gray-800">@Model.TenBan</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Gallery Section -->
            <div class="bg-white rounded-2xl shadow-md overflow-hidden">
                <div class="bg-gradient-to-r from-blue-600 to-indigo-600 px-6 py-4 flex items-center justify-between">
                    <h2 class="text-xl font-bold text-white">Hoạt động nổi bật của CLB</h2>
                    <span class="text-2xl">🖼️</span>
                </div>
                <div class="p-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        @foreach (var hoatDong in Model.DanhSachHoatDong)
                        {
                            <div class="gallery-item group relative bg-gray-100 rounded-xl overflow-hidden shadow-md hover-scale">
                                <div class="aspect-video overflow-hidden">
                                    <img src="@hoatDong.HinhAnh" alt="@hoatDong.TenHD" class="w-full h-full object-cover">
                                </div>
                                <div class="gallery-overlay">
                                    <span class="inline-block px-3 py-1 bg-blue-600 text-white text-xs font-semibold rounded-full mb-2 w-fit">
                                        @hoatDong.TenLoaiHD
                                    </span>
                                    <h3 class="text-white font-bold text-lg mb-1">@hoatDong.TenHD</h3>
                                    <p class="text-gray-200 text-sm mb-2">@hoatDong.MoTa</p>
                                    <p class="text-gray-300 text-xs">📅 @hoatDong.NgayToChuc?.ToString("dd/MM/yyyy")</p>
                                </div>
                                <div class="p-4">
                                    <div class="flex items-center justify-between mb-2">
                                        <span class="inline-block px-2 py-1 bg-blue-100 text-blue-700 text-xs font-semibold rounded">
                                            @hoatDong.TenLoaiHD
                                        </span>
                                        <span class="text-xs text-gray-500">@hoatDong.NgayToChuc?.ToString("dd/MM/yyyy")</span>
                                    </div>
                                    <h3 class="font-bold text-gray-800 text-sm mb-2">@hoatDong.TenHD</h3>
                                    <p class="text-xs text-gray-600 line-clamp-2">@hoatDong.MoTa</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- TIMELINE TAB -->
        <div id="content-timeline" class="tab-content hidden">
            <div class="bg-white rounded-2xl shadow-md overflow-hidden">
                <div class="bg-gradient-to-r from-blue-600 to-indigo-600 px-6 py-4">
                    <h2 class="text-xl font-bold text-white">Lịch trình hoạt động</h2>
                </div>
                <div class="p-6">
                    <div class="space-y-4">
                        @foreach (var item in Model.DanhSachTimeline)
                        {
                            var cssClass = item.MucDoUuTien == "Cao" ? "high pl-6 py-4 bg-red-50 rounded-lg" :
                            item.MucDoUuTien == "Trung bình" ? "medium pl-6 py-4 bg-yellow-50 rounded-lg" :
                            "low pl-6 py-4 bg-green-50 rounded-lg";
                            var badgeClass = item.MucDoUuTien == "Cao" ? "px-3 py-1 bg-red-600 text-white text-xs font-semibold rounded-full" :
                            item.MucDoUuTien == "Trung bình" ? "px-3 py-1 bg-yellow-600 text-white text-xs font-semibold rounded-full" :
                            "px-3 py-1 bg-green-600 text-white text-xs font-semibold rounded-full";

                            <div class="timeline-item @cssClass">
                                <div class="flex items-start justify-between">
                                    <div class="flex-1">
                                        <div class="flex items-center space-x-2 mb-2">
                                            <span class="@badgeClass">@item.MucDoUuTien</span>
                                            <span class="text-xs text-gray-500">@item.NgayDienRa?.ToString("dd/MM/yyyy")</span>
                                        </div>
                                        <h3 class="font-bold text-gray-800 mb-1">@item.TieuDe</h3>
                                        <p class="text-sm text-gray-600">@item.NoiDung</p>
                                        @if (!string.IsNullOrEmpty(item.DiaDiem))
                                        {
                                            <p class="text-xs text-gray-500 mt-1">📍 @item.DiaDiem</p>
                                        }
                                    </div>
                                    <span class="text-2xl">@item.Icon</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- AWARDS TAB -->
        <div id="content-awards" class="tab-content hidden">
            <div class="grid md:grid-cols-2 gap-6">
                <!-- Personal Awards -->
                <div class="bg-white rounded-2xl shadow-md overflow-hidden">
                    <div class="bg-gradient-to-r from-yellow-500 to-orange-500 px-6 py-4">
                        <h2 class="text-xl font-bold text-white">Thành tích cá nhân</h2>
                    </div>
                    <div class="p-6 space-y-4">
                        @foreach (var kt in Model.DanhSachKhenThuong)
                        {
                            var bgClass = kt.LoaiKhenThuong == "Gold" ? "gold bg-gradient-to-br from-yellow-50 to-orange-50" :
                            kt.LoaiKhenThuong == "Silver" ? "silver bg-gradient-to-br from-gray-50 to-gray-100" :
                            "gold bg-gradient-to-br from-blue-50 to-indigo-50";
                            var icon = kt.LoaiKhenThuong == "Gold" ? "🏆" :
                            kt.LoaiKhenThuong == "Silver" ? "🥈" : "⭐";

                            <div class="award-card @bgClass rounded-xl p-4 shadow-sm">
                                <div class="flex items-start space-x-4">
                                    <div class="text-5xl">@icon</div>
                                    <div class="flex-1">
                                        <h3 class="font-bold text-gray-800 mb-1">@kt.LyDo</h3>
                                        <span class="text-xs text-gray-500">📅 @kt.NgayKT?.ToString("dd/MM/yyyy")</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Achievement Stats -->
                <div class="bg-white rounded-2xl shadow-md overflow-hidden">
                    <div class="bg-gradient-to-r from-purple-600 to-pink-600 px-6 py-4">
                        <h2 class="text-xl font-bold text-white">Thống kê thành tích</h2>
                    </div>
                    <div class="p-6">
                        <div class="grid grid-cols-2 gap-4">
                            <div class="text-center p-4 bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl">
                                <div class="text-4xl mb-2">🏆</div>
                                <p class="text-2xl font-bold text-gray-800">@Model.SoGiaiThuong</p>
                                <p class="text-sm text-gray-600">Giải thưởng</p>
                            </div>
                            <div class="text-center p-4 bg-gradient-to-br from-green-50 to-emerald-50 rounded-xl">
                                <div class="text-4xl mb-2">📚</div>
                                <p class="text-2xl font-bold text-gray-800">@Model.TongDuAn</p>
                                <p class="text-sm text-gray-600">Dự án tham gia</p>
                            </div>
                            <div class="text-center p-4 bg-gradient-to-br from-purple-50 to-pink-50 rounded-xl">
                                <div class="text-4xl mb-2">⭐</div>
                                <p class="text-2xl font-bold text-gray-800">@(Model.DiemRenLuyen ?? 0)</p>
                                <p class="text-sm text-gray-600">Điểm rèn luyện</p>
                            </div>
                            <div class="text-center p-4 bg-gradient-to-br from-yellow-50 to-orange-50 rounded-xl">
                                <div class="text-4xl mb-2">📅</div>
                                <p class="text-2xl font-bold text-gray-800">@Model.TongSuKien</p>
                                <p class="text-sm text-gray-600">Sự kiện CLB</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

<!-- Gallery Item 1 -->
<div class="gallery-item group relative bg-gray-100 rounded-xl overflow-hidden shadow-md hover:scale-105 transition-transform duration-300">
    <!-- Image -->
    <div class="aspect-video overflow-hidden">
        <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=800"
             alt="Chiến dịch Mùa hè xanh 2025"
             class="w-full h-full object-cover">
    </div>

    <!-- Overlay (xuất hiện khi hover) -->
    <div class="gallery-overlay absolute inset-0 bg-black bg-opacity-50 opacity-0 group-hover:opacity-100 transition-opacity p-4 flex flex-col justify-end">
        <span class="inline-block px-3 py-1 bg-blue-600 text-white text-xs font-semibold rounded-full mb-2 w-fit">
            Tình nguyện
        </span>
        <h3 class="text-white font-bold text-lg mb-1">Chiến dịch Mùa hè xanh 2025</h3>
        <p class="text-gray-200 text-sm mb-2">Hoạt động tình nguyện giúp đỡ bà con tại vùng nông thôn Củ Chi</p>
        <p class="text-gray-300 text-xs">📅 10/07/2025</p>
    </div>

    <!-- Card thông tin bên dưới hình -->
    <div class="p-4">
        <div class="flex items-center justify-between mb-2">
            <span class="inline-block px-2 py-1 bg-blue-100 text-blue-700 text-xs font-semibold rounded">
                Tình nguyện
            </span>
            <span class="text-xs text-gray-500">10/07/2025</span>
        </div>
        <h3 class="font-bold text-gray-800 text-sm mb-2">Chiến dịch Mùa hè xanh 2025</h3>
        <p class="text-xs text-gray-600 line-clamp-2">Hoạt động tình nguyện giúp đỡ bà con tại vùng nông thôn Củ Chi</p>
    </div>
</div>


<!-- Gallery Item 2 -->
<div class="gallery-item group relative bg-gray-100 rounded-xl overflow-hidden shadow-md hover-scale">
    <div class="aspect-video overflow-hidden">
        <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=800" alt="Hội thảo kỹ năng mềm" class="w-full h-full object-cover">
    </div>
    <div class="gallery-overlay">
        <span class="inline-block px-3 py-1 bg-blue-600 text-white text-xs font-semibold rounded-full mb-2 w-fit">
            Học thuật
        </span>
        <h3 class="text-white font-bold text-lg mb-1">Hội thảo kỹ năng mềm</h3>
        <p class="text-gray-200 text-sm mb-2">Workshop về kỹ năng giao tiếp và làm việc nhóm hiệu quả</p>
        <p class="text-gray-300 text-xs">📅 15/08/2025</p>
    </div>
    <div class="p-4">
        <div class="flex items-center justify-between mb-2">
            <span class="inline-block px-2 py-1 bg-green-100 text-green-700 text-xs font-semibold rounded">
                Học thuật
            </span>
            <span class="text-xs text-gray-500">15/08/2025</span>
        </div>
        <h3 class="font-bold text-gray-800 text-sm mb-2">Hội thảo kỹ năng mềm</h3>
        <p class="text-xs text-gray-600 line-clamp-2">Workshop về kỹ năng giao tiếp và làm việc nhóm hiệu quả</p>
    </div>
</div>

<!-- Gallery Item 3 -->
<div class="gallery-item group relative bg-gray-100 rounded-xl overflow-hidden shadow-md hover-scale">
    <div class="aspect-video overflow-hidden">
        <img src="https://images.unsplash.com/photo-1511632765486-a01980e01a18?w=800" alt="Team Building" class="w-full h-full object-cover">
    </div>
    <div class="gallery-overlay">
        <span class="inline-block px-3 py-1 bg-blue-600 text-white text-xs font-semibold rounded-full mb-2 w-fit">
            Giải trí
        </span>
        <h3 class="text-white font-bold text-lg mb-1">Team Building Vũng Tàu</h3>
        <p class="text-gray-200 text-sm mb-2">Chuyến du lịch gắn kết và tạo tinh thần đồng đội</p>
        <p class="text-gray-300 text-xs">📅 05/09/2025</p>
    </div>
    <div class="p-4">
        <div class="flex items-center justify-between mb-2">
            <span class="inline-block px-2 py-1 bg-purple-100 text-purple-700 text-xs font-semibold rounded">
                Giải trí
            </span>
            <span class="text-xs text-gray-500">05/09/2025</span>
        </div>
        <h3 class="font-bold text-gray-800 text-sm mb-2">Team Building Vũng Tàu</h3>
        <p class="text-xs text-gray-600 line-clamp-2">Chuyến du lịch gắn kết và tạo tinh thần đồng đội</p>
    </div>
</div>

<!-- Gallery Item 4 -->
<div class="gallery-item group relative bg-gray-100 rounded-xl overflow-hidden shadow-md hover-scale">
    <div class="aspect-video overflow-hidden">
        <img src="https://images.unsplash.com/photo-1517457373958-b7bdd4587205?w=800" alt="Hackathon" class="w-full h-full object-cover">
    </div>
    <div class="gallery-overlay">
        <span class="inline-block px-3 py-1 bg-blue-600 text-white text-xs font-semibold rounded-full mb-2 w-fit">
            Học thuật
        </span>
