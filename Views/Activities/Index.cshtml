@model IEnumerable<QuanLyCLB_LSC.Models.HoatDong>
@{
    ViewData["Title"] = "Quản lý hoạt động";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản Trị - Hoạt Động</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/dashboard.css" />
</head>
<body>
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-circle">LSC</div>
            <h5 class="mb-0">Admin</h5>
            <small>Life Skills Club</small>
        </div>

        <div class="sidebar-menu">
            <a href="@Url.Action("Index", "Dashboard")" class="menu-item" onclick="showSection('dashboard')">
                <i class="fas fa-home"></i>
                <span>Trang Chủ</span>
            </a>
            <a href="@Url.Action("Index", "Members")" class="menu-item" onclick="showSection('members')">
                <i class="fas fa-users"></i>
                <span>Thành Viên</span>
            </a>
            <a href="@Url.Action("Index", "Activities")" class="menu-item active" onclick="showSection('activities')">
                <i class="fas fa-calendar-alt"></i>
                <span>Hoạt Động</span>
            </a>
            <a href="#" class="menu-item" onclick="showSection('projects')">
                <i class="fas fa-project-diagram"></i>
                <span>Dự Án</span>
            </a>
            <a href="#" class="menu-item" onclick="showSection('finance')">
                <i class="fas fa-wallet"></i>
                <span>Tài Chính</span>
            </a>
            <a href="@Url.Action("Index", "Reports")" class="menu-item" onclick="showSection('reports')">
                <i class="fas fa-chart-bar"></i>
                <span>Báo Cáo</span>
            </a>
            <a href="@Url.Action("Index", "Settings")" class="menu-item" onclick="showSection('settings')">
                <i class="fas fa-cog"></i>
                <span>Cài Đặt</span>
            </a>
            <a href="@Url.Action("Login", "Auth")" class="menu-item" onclick="logout()">
                <i class="fas fa-sign-out-alt"></i>
                <span>Đăng Xuất</span>
            </a>
        </div>
    </div>

    <div class="main-content" id="mainContent">
        <div class="top-header">
            <div>
                <button class="toggle-btn" onclick="toggleSidebar()">
                    <i class="fas fa-bars"></i>
                </button>
            </div>

            <div class="user-info">
                <div class="position-relative">
                    <i class="fas fa-bell" style="font-size: 22px; color: #667eea; cursor: pointer;"></i>
                  
                </div>
                <div>
                    <div class="fw-bold">Admin</div>
                    <small class="text-muted">Quản trị viên</small>
                </div>
                <div class="user-avatar">
                    <i class="fas fa-user"></i>
                </div>
            </div>
        </div>

        <div class="dashboard-content">
            <h2 class="mb-4"><i class="fas fa-calendar-alt me-2" style="color: var(--primary-color);"></i>Quản lý Hoạt Động</h2>

            <div class="row g-4 mb-4">
                <div class="col-xl-3 col-md-6">
                    <div class="stat-card blue">
                        <div class="stat-icon"><i class="fas fa-calendar-days"></i></div>
                        <div class="stat-number">@ViewBag.TotalActivities</div>
                        <div class="stat-label">Tổng hoạt động</div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="stat-card green">
                        <div class="stat-icon"><i class="fas fa-calendar-check"></i></div>
                        <div class="stat-number">@ViewBag.ActivitiesThisMonth</div>
                        <div class="stat-label">Hoạt động tháng này</div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="stat-card orange">
                        <div class="stat-icon"><i class="fas fa-clock"></i></div>
                        <div class="stat-number">@ViewBag.ActiveActivities</div>
                        <div class="stat-label">Đang chuẩn bị</div>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-lg-8">
                    <div class="chart-card">
                        <div class="chart-header d-flex justify-content-between align-items-center">
                            <h5 class="chart-title"><i class="fas fa-chart-area me-2"></i>Hoạt động trong năm</h5>
                            <select id="yearSelect" class="form-select" style="width: auto;" onchange="onYearChange(this.value)">
                                @{ 
                                    var years = ViewBag.AvailableYears as List<int> ?? new List<int> { DateTime.Now.Year };
                                    var sel = ViewBag.SelectedYear as int? ?? DateTime.Now.Year;
                                }
                                @foreach (var y in years)
                                {
                                    if (y == sel)
                                    {
                                        <option value="@y" selected>@y</option>
                                    }
                                    else
                                    {
                                        <option value="@y">@y</option>
                                    }
                                }
                            </select>
                        </div>
                        <canvas id="activityChart" height="100"></canvas>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card">
                        <div class="card-body">
                            <h5>Hoạt động nổi bật</h5>
                            <ul class="list-group list-group-flush">
                                @if (ViewBag.FeaturedActivities != null)
                                {
                                    foreach (var fa in ViewBag.FeaturedActivities as List<QuanLyCLB_LSC.Models.HoatDong>)
                                    {
                                        <li class="list-group-item">
                                            <div class="d-flex justify-content-between">
                                                <div>
                                                    <strong>@fa.TenHd</strong>
                                                    <div class="small text-muted">@fa.NgayToChuc?.ToString("dd/MM/yyyy")</div>
                                                </div>
                                                <div>
                                                    <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Details", "Activities", new { id = fa.MaHd })">Xem</a>
                                                </div>
                                            </div>
                                        </li>
                                    }
                                }
                                else
                                {
                                    <li class="list-group-item">Chưa có hoạt động nổi bật</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="quick-actions mb-4">
                <a class="action-btn btn btn-primary" href="@Url.Action("Create", "Activities")"><i class="fas fa-calendar-plus me-2"></i>Tạo hoạt động</a>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <form method="get" class="row g-2 mb-3">
                        <div class="col-md-4">
                            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo tên, mô tả hoặc địa điểm" />
                        </div>
                        <div class="col-md-3">
                            <select name="loaiId" class="form-select">
                                <option value="">-- Lọc theo loại --</option>
                                @foreach (var l in ViewBag.LoaiHoatDongs as List<QuanLyCLB_LSC.Models.LoaiHoatDong>)
                                {
                                    if (ViewBag.LoaiId == l.MaLoaiHd)
                                    {
                                        <option value="@l.MaLoaiHd" selected>@l.TenLoaiHd</option>
                                    }
                                    else
                                    {
                                        <option value="@l.MaLoaiHd">@l.TenLoaiHd</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select name="nguoiId" class="form-select">
                                <option value="">-- Lọc theo người phụ trách --</option>
                                @foreach (var t in ViewBag.ThanhViens as List<QuanLyCLB_LSC.Models.ThanhVien>)
                                {
                                    if (ViewBag.NguoiId == t.MaTv)
                                    {
                                        <option value="@t.MaTv" selected>@t.HoTen</option>
                                    }
                                    else
                                    {
                                        <option value="@t.MaTv">@t.HoTen</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-primary">Tìm</button>
                        </div>
                    </form>

                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Tên hoạt động</th>
                                    <th>Ngày tổ chức</th>
                                    <th>Địa điểm</th>
                                    <th>Người phụ trách</th>
                                    <th>Trạng thái</th>
                                    <th>Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.MaHd</td>
                                        <td>@item.TenHd</td>
                                        <td>@(item.NgayToChuc?.ToString("dd/MM/yyyy") ?? "Chưa rõ")</td>
                                        <td>@(item.DiaDiem ?? "Chưa xác định")</td>
                                        <td>@item.NguoiPhuTrachNavigation?.HoTen</td>
                                        <td>
                                            @if (item.TrangThai == "Hoàn thành")
                                            {
                                                <span class="badge bg-success">@item.TrangThai</span>
                                            }
                                            else if (item.TrangThai == "Đang chuẩn bị")
                                            {
                                                <span class="badge bg-warning text-dark">@item.TrangThai</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@item.TrangThai</span>
                                            }
                                        </td>
                                        <td>
                                            <a class="btn btn-sm btn-info" href="@Url.Action("Details", "Activities", new { id = item.MaHd })">Xem</a>
                                            <a class="btn btn-sm btn-warning ms-1" href="@Url.Action("Edit", "Activities", new { id = item.MaHd })">Sửa</a>
                                            <form asp-action="DeleteConfirmed" asp-controller="Activities" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@item.MaHd" />
                                                <button type="submit" class="btn btn-sm btn-danger ms-1" onclick="return confirm('Bạn có chắc muốn xóa?')">Xóa</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
    <script>
        function onYearChange(year) {
            // preserve existing query params (search, loaiId, nguoiId) and change/add year
            const url = new URL(window.location.href);
            url.searchParams.set('year', year);
            // keep other params as-is (they are already in url)
            window.location.href = url.toString();
        }

        document.addEventListener('DOMContentLoaded', function () {
            try {
                let labels = @Html.Raw(ViewBag.ActivityChartLabels ?? "[]");
                let data = @Html.Raw(ViewBag.ActivityChartData ?? "[]");

                // Ensure parsed arrays
                if (typeof labels === 'string') {
                    labels = JSON.parse(labels);
                }
                if (typeof data === 'string') {
                    data = JSON.parse(data);
                }

                console.log('Activity chart labels:', labels);
                console.log('Activity chart data:', data);

                const canvas = document.getElementById('activityChart');
                if (!canvas) {
                    console.warn('activityChart canvas not found');
                    return;
                }

                const ctx = canvas.getContext('2d');
                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Số hoạt động',
                            data: data,
                            backgroundColor: 'rgba(54, 162, 235, 0.2)',
                            borderColor: 'rgba(54, 162, 235, 1)',
                            borderWidth: 1,
                            fill: true,
                            tension: 0.4
                        }]
                    },
                    options: {
                        responsive: true,
                        scales: {
                            y: { beginAtZero: true }
                        }
                    }
                });
            }
            catch (ex) {
                console.error('Error rendering activity chart', ex);
            }
        });
    </script>
    <script src="~/js/dashboard.js"></script>
</body>
</html>