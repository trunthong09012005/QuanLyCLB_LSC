@model IEnumerable<QuanLyCLB_LSC.Models.HoatDong>
@{
    ViewData["Title"] = "Hoạt động - CLB Kỹ Năng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/dashboard.css" />

<body>
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-circle"> <img src="@(Url.Content("~/img/logolsc.png"))" class="logo-circle-img" /></div>
            <h5 class="mb-0">Admin</h5>
            <small>Life Skills Club</small>
        </div>

        <div class="sidebar-menu">
            <a href="@Url.Action("Index", "Dashboard")" class="menu-item" onclick="showSection('dashboard')">
                <i class="fas fa-home"></i>
                <span>Trang Chủ</span>
            </a>
            <a href="@Url.Action("Index", "Members")" class="menu-item" onclick="showSection('members')">
                <i class="fas fa-users"></i>
                <span>Thành Viên</span>
            </a>
            <a href="@Url.Action("Index", "Activities")" class="menu-item active" onclick="showSection('activities')">
                <i class="fas fa-calendar-alt"></i>
                <span>Hoạt Động</span>
            </a>
            <a href="@Url.Action("Index", "Project")" class="menu-item" onclick="showSection('projects')">
                <i class="fas fa-project-diagram"></i>
                <span>Dự Án</span>
            </a>
            <a href="@Url.Action("Index", "Finance")" class="menu-item" onclick="showSection('finance')">
                <i class="fas fa-wallet"></i>
                <span>Tài Chính</span>
            </a>
            <a href="@Url.Action("Index", "Reports")" class="menu-item" onclick="showSection('reports')">
                <i class="fas fa-chart-bar"></i>
                <span>Báo Cáo</span>
            </a>
            <a href="@Url.Action("Index", "Settings")" class="menu-item" onclick="showSection('settings')">
                <i class="fas fa-cog"></i>
                <span>Cài Đặt</span>
            </a>
            <a href="@Url.Action("Login", "Auth")" class="menu-item" onclick="logout()">
                <i class="fas fa-sign-out-alt"></i>
                <span>Đăng Xuất</span>
            </a>
        </div>
    </div>

    <div class="main-content" id="mainContent">
        <div class="top-header">
            <div>
                <button class="toggle-btn" onclick="toggleSidebar()">
                    <i class="fas fa-bars"></i>
                </button>
            </div>

            <div class="user-info">
                <div class="position-relative">
                    <i class="fas fa-bell" style="font-size: 22px; color: #667eea; cursor: pointer;"></i>
                  
                </div>
                <div>
                    <div class="fw-bold">Admin</div>
                    <small class="text-muted">Quản trị viên</small>
                </div>
                <div class="user-avatar">
                    <i class="fas fa-user"></i>
                </div>
            </div>
        </div>

        <div class="dashboard-content">
            <h2 class="mb-4"><i class="fas fa-calendar-alt me-2" style="color: var(--primary-color);"></i>Quản lý Hoạt Động</h2>

            <div class="row g-4 mb-4">
                <div class="col-xl-3 col-md-6">
                    <div class="stat-card blue">
                        <div class="stat-icon"><i class="fas fa-calendar-days"></i></div>
                        <div class="stat-number">@ViewBag.TotalActivities</div>
                        <div class="stat-label">Tổng hoạt động</div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="stat-card green">
                        <div class="stat-icon"><i class="fas fa-calendar-check"></i></div>
                        <div class="stat-number">@ViewBag.ActivitiesThisMonth</div>
                        <div class="stat-label">Hoạt động tháng này</div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="stat-card orange">
                        <div class="stat-icon"><i class="fas fa-clock"></i></div>
                        <div class="stat-number">@ViewBag.ActiveActivities</div>
                        <div class="stat-label">Đang chuẩn bị</div>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-lg-8">
                    <div class="chart-card">
                        <div class="chart-header d-flex justify-content-between align-items-center">
                            <h5 class="chart-title"><i class="fas fa-chart-area me-2"></i>Hoạt động trong năm</h5>
                            <select id="yearSelect" class="form-select" style="width: auto;" onchange="onYearChange(this.value)">
                                @{ 
                                    var years = ViewBag.AvailableYears as List<int> ?? new List<int> { DateTime.Now.Year };
                                    var sel = ViewBag.SelectedYear as int? ?? DateTime.Now.Year;
                                }
                                @foreach (var y in years)
                                {
                                    if (y == sel)
                                    {
                                        <option value="@y" selected>@y</option>
                                    }
                                    else
                                    {
                                        <option value="@y">@y</option>
                                    }
                                }
                            </select>
                        </div>
                        <canvas id="activityChart" height="100"></canvas>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card">
                        <div class="card-body">
                            <h5>Hoạt động nổi bật</h5>
                            <ul class="list-group list-group-flush">
                                @if (ViewBag.FeaturedActivities != null)
                                {
                                    foreach (var fa in ViewBag.FeaturedActivities as List<QuanLyCLB_LSC.Models.HoatDong>)
                                    {
                                        <li class="list-group-item">
                                            <div class="d-flex justify-content-between">
                                                <div>
                                                    <strong>@fa.TenHd</strong>
                                                    <div class="small text-muted">@fa.NgayToChuc?.ToString("dd/MM/yyyy")</div>
                                                </div>
                                                <div>
                                                    <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Details", "Activities", new { id = fa.MaHd })">Xem</a>
                                                </div>
                                            </div>
                                        </li>
                                    }
                                }
                                else
                                {
                                    <li class="list-group-item">Chưa có hoạt động nổi bật</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="quick-actions mb-4">
                <a class="action-btn btn btn-primary" href="@Url.Action("Create", "Activities")"><i class="fas fa-calendar-plus me-2"></i>Tạo hoạt động</a>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <form id="activityFilterForm" method="get" class="row g-2 mb-3">
                        <div class="col-md-4">
                            <input id="activitySearch" type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo tên, mô tả hoặc địa điểm" autocomplete="off" />
                        </div>
                        <div class="col-md-3">
                            <select name="loaiId" class="form-select">
                                <option value="">-- Lọc theo loại --</option>
                                @foreach (var l in ViewBag.LoaiHoatDongs as List<QuanLyCLB_LSC.Models.LoaiHoatDong>)
                                {
                                    if (ViewBag.LoaiId == l.MaLoaiHd)
                                    {
                                        <option value="@l.MaLoaiHd" selected>@l.TenLoaiHd</option>
                                    }
                                    else
                                    {
                                        <option value="@l.MaLoaiHd">@l.TenLoaiHd</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select name="nguoiId" class="form-select">
                                <option value="">-- Lọc theo người phụ trách --</option>
                                @foreach (var t in ViewBag.ThanhViens as List<QuanLyCLB_LSC.Models.ThanhVien>)
                                {
                                    if (ViewBag.NguoiId == t.MaTv)
                                    {
                                        <option value="@t.MaTv" selected>@t.HoTen</option>
                                    }
                                    else
                                    {
                                        <option value="@t.MaTv">@t.HoTen</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button id="activitySearchBtn" class="btn btn-primary">Tìm</button>
                        </div>
                        <input type="hidden" id="actSortBy" name="sortBy" value="@(ViewBag.SortBy ?? "")" />
                        <input type="hidden" id="actSortDir" name="sortDir" value="@(ViewBag.SortDir ?? "")" />
                     </form>

                    <div id="dataTableCard" class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th class="sortable" data-sort="mahd" style="cursor:pointer"># <span class="sort-ind">@(ViewBag.SortBy=="mahd"?(ViewBag.SortDir=="asc"?"▲":"▼"):"")</span></th>
                                    <th class="sortable" data-sort="tenhd" style="cursor:pointer">Tên hoạt động <span class="sort-ind">@(ViewBag.SortBy=="tenhd"?(ViewBag.SortDir=="asc"?"▲":"▼"):"")</span></th>
                                    <th class="sortable" data-sort="ngaytochuc" style="cursor:pointer">Ngày tổ chức <span class="sort-ind">@(ViewBag.SortBy=="ngaytochuc"?(ViewBag.SortDir=="asc"?"▲":"▼"):"")</span></th>
                                    <th class="sortable" data-sort="diadiem" style="cursor:pointer">Địa điểm <span class="sort-ind">@(ViewBag.SortBy=="diadiem"?(ViewBag.SortDir=="asc"?"▲":"▼"):"")</span></th>
                                    <th class="sortable" data-sort="nguoi" style="cursor:pointer">Người phụ trách <span class="sort-ind">@(ViewBag.SortBy=="nguoi"?(ViewBag.SortDir=="asc"?"▲":"▼"):"")</span></th>
                                    <th class="sortable" data-sort="trangthai" style="cursor:pointer">Trạng thái <span class="sort-ind">@(ViewBag.SortBy=="trangthai"?(ViewBag.SortDir=="asc"?"▲":"▼"):"")</span></th>
                                    <th>Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.MaHd</td>
                                        <td>@item.TenHd</td>
                                        <td>@(item.NgayToChuc?.ToString("dd/MM/yyyy") ?? "Chưa rõ")</td>
                                        <td>@(item.DiaDiem ?? "Chưa xác định")</td>
                                        <td>@item.NguoiPhuTrachNavigation?.HoTen</td>
                                        <td>
                                            @{
                                                var statusMap = ViewBag.ActivityStatuses as Dictionary<int, string> ?? new Dictionary<int, string>();
                                                var s = statusMap.ContainsKey(item.MaHd) ? statusMap[item.MaHd] : (item.TrangThai ?? "Chưa rõ");
                                            }
                                            @if (s == "Đã tổ chức")
                                            {
                                                <span class="badge bg-secondary">@s</span>
                                            }
                                            else if (s == "Đang diễn ra")
                                            {
                                                <span class="badge bg-success">@s</span>
                                            }
                                            else if (s == "Sắp diễn ra")
                                            {
                                                <span class="badge bg-info text-dark">@s</span>
                                            }
                                            else if (s == "Đang chuẩn bị")
                                            {
                                                <span class="badge bg-warning text-dark">@s</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@s</span>
                                            }
                                        </td>
                                        <td>
                                            <a class="btn btn-sm btn-info" href="@Url.Action("Details", "Activities", new { id = item.MaHd })">Xem</a>
                                            <a class="btn btn-sm btn-warning ms-1" href="@Url.Action("Edit", "Activities", new { id = item.MaHd })">Sửa</a>
                                            <form asp-action="DeleteConfirmed" asp-controller="Activities" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@item.MaHd" />
                                                <button type="submit" class="btn btn-sm btn-danger ms-1" onclick="return confirm('Bạn có chắc muốn xóa?')">Xóa</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
    <script>
        function onYearChange(year) {
            // preserve existing query params (search, loaiId, nguoiId) and change/add year
            const url = new URL(window.location.href);
            url.searchParams.set('year', year);
            // keep other params as-is (they are already in url)
            window.location.href = url.toString();
        }

        document.addEventListener('DOMContentLoaded', function () {
            try {
                let labels = @Html.Raw(ViewBag.ActivityChartLabels ?? "[]");
                let data = @Html.Raw(ViewBag.ActivityChartData ?? "[]");

                // Ensure parsed arrays
                if (typeof labels === 'string') {
                    labels = JSON.parse(labels);
                }
                if (typeof data === 'string') {
                    data = JSON.parse(data);
                }

                console.log('Activity chart labels:', labels);
                console.log('Activity chart data:', data);

                const canvas = document.getElementById('activityChart');
                if (!canvas) {
                    console.warn('activityChart canvas not found');
                    return;
                }

                const ctx = canvas.getContext('2d');
                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Số hoạt động',
                            data: data,
                            backgroundColor: 'rgba(54, 162, 235, 0.2)',
                            borderColor: 'rgba(54, 162, 235, 1)',
                            borderWidth: 1,
                            fill: true,
                            tension: 0.4
                        }]
                    },
                    options: {
                        responsive: true,
                        scales: {
                            y: { beginAtZero: true }
                        }
                    }
                });
            }
            catch (ex) {
                console.error('Error rendering activity chart', ex);
            }
        });
    </script>
    <script src="~/js/dashboard.js"></script>
    <script>
        // AJAX update for Activities table (search, filter, sort) without full reload
        (function(){
            const searchInput = document.getElementById('activitySearch');
            const loaiSelect = document.querySelector('select[name="loaiId"]');
            const nguoiSelect = document.querySelector('select[name="nguoiId"]');
            const dataCard = document.getElementById('dataTableCard');
            const form = document.getElementById('activityFilterForm');
            const sortByInput = document.getElementById('actSortBy');
            const sortDirInput = document.getElementById('actSortDir');

            function buildUrl(){
                const params = new URLSearchParams();
                if (searchInput && searchInput.value) params.set('search', searchInput.value);
                if (loaiSelect && loaiSelect.value) params.set('loaiId', loaiSelect.value);
                if (nguoiSelect && nguoiSelect.value) params.set('nguoiId', nguoiSelect.value);
                if (sortByInput && sortByInput.value) params.set('sortBy', sortByInput.value);
                if (sortDirInput && sortDirInput.value) params.set('sortDir', sortDirInput.value);
                return '/Activities/Index?' + params.toString();
            }

            async function fetchData(){
                try{
                    const url = buildUrl();
                    console.log('[Activities] fetch url:', url);
                    const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (!res.ok) return;
                    const text = await res.text();
                    console.log('[Activities] response length:', text.length);
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(text, 'text/html');
                    const newCard = doc.getElementById('dataTableCard');
                    if (newCard && dataCard) {
                        dataCard.innerHTML = newCard.innerHTML;
                    } else {
                        console.warn('[Activities] dataTableCard not found in response, fallback to replacing entire main content');
                        const main = doc.querySelector('.dashboard-content');
                        const currentMain = document.querySelector('.dashboard-content');
                        if (main && currentMain) currentMain.innerHTML = main.innerHTML;
                    }
                    history.replaceState(null, '', url);
                }catch(e){ console.error(e); }
            }

            // debounce search
            let t;
            if (searchInput) searchInput.addEventListener('input', function(){ clearTimeout(t); t = setTimeout(fetchData, 300); });
            if (loaiSelect) loaiSelect.addEventListener('change', fetchData);
            if (nguoiSelect) nguoiSelect.addEventListener('change', fetchData);

            // sortable header clicks inside dataCard
            dataCard.addEventListener('click', function(e){
                const th = e.target.closest('th.sortable');
                if (!th) return;
                const key = th.getAttribute('data-sort');
                if (!key) return;
                if (sortByInput.value === key) sortDirInput.value = (sortDirInput.value === 'asc') ? 'desc' : 'asc';
                else { sortByInput.value = key; sortDirInput.value = 'asc'; }
                fetchData();
            });

            if (form) form.addEventListener('submit', function(e){ e.preventDefault(); fetchData(); });
        })();
    </script>
</body>
</html>