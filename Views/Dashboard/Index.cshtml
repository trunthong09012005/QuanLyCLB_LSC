@model QuanLyCLB_LSC.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard - CLB Kỹ Năng Sống";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản Trị - CLB Kỹ Năng Sống</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/dashboard.css" />
</head>
<body>
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-circle">LSC</div>
            <h5 class="mb-0">Admin Panel</h5>
            <small>CLB Kỹ Năng Sống</small>
        </div>

        <div class="sidebar-menu">
            <a href="#" class="menu-item active" onclick="showSection('dashboard')">
                <i class="fas fa-home"></i>
                <span>Trang Chủ</span>
            </a>
            <a href="#" class="menu-item" onclick="showSection('members')">
                <i class="fas fa-users"></i>
                <span>Thành Viên</span>
            </a>
            <a href="#" class="menu-item" onclick="showSection('activities')">
                <i class="fas fa-calendar-alt"></i>
                <span>Hoạt Động</span>
            </a>
            <a href="#" class="menu-item" onclick="showSection('projects')">
                <i class="fas fa-project-diagram"></i>
                <span>Dự Án</span>
            </a>
            <a href="#" class="menu-item" onclick="showSection('finance')">
                <i class="fas fa-wallet"></i>
                <span>Tài Chính</span>
            </a>
            <a href="#" class="menu-item" onclick="showSection('reports')">
                <i class="fas fa-chart-bar"></i>
                <span>Báo Cáo</span>
            </a>
            <a href="#" class="menu-item" onclick="showSection('settings')">
                <i class="fas fa-cog"></i>
                <span>Cài Đặt</span>
            </a>
            <a href="#" class="menu-item" onclick="logout()">
                <i class="fas fa-sign-out-alt"></i>
                <span>Đăng Xuất</span>
            </a>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content" id="mainContent">
        <!-- Top Header -->
        <div class="top-header">
            <div>
                <button class="toggle-btn" onclick="toggleSidebar()">
                    <i class="fas fa-bars"></i>
                </button>
            </div>

            <div class="user-info">
                <div class="position-relative">
                    <i class="fas fa-bell" style="font-size: 22px; color: #667eea; cursor: pointer;"></i>
                    <span class="notification-badge">5</span>
                </div>
                <div>
                    <div class="fw-bold">Admin</div>
                    <small class="text-muted">Quản trị viên</small>
                </div>
                <div class="user-avatar">
                    <i class="fas fa-user"></i>
                </div>
            </div>
        </div>

        <!-- Dashboard Content -->
        <div class="dashboard-content">
            <h2 class="mb-4">
                <i class="fas fa-chart-line me-2" style="color: var(--primary-color);"></i>
                Tổng Quan Dashboard
            </h2>

            <!-- Statistics Cards -->
            <div class="row g-4">
                <div class="col-xl-3 col-md-6">
                    <div class="stat-card blue">
                        <div class="stat-icon">
                            <i class="fas fa-users"></i>
                        </div>
                        <div class="stat-number">@ViewBag.TongThanhVien</div>
                        <div class="stat-label">Tổng Thành Viên</div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6">
                    <div class="stat-card green">
                        <div class="stat-icon">
                            <i class="fas fa-calendar-check"></i>
                        </div>
                        <div class="stat-number">@ViewBag.HoatDongThangNay</div>
                        <div class="stat-label">Hoạt Động Tháng Này</div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6">
                    <div class="stat-card orange">
                        <div class="stat-icon">
                            <i class="fas fa-project-diagram"></i>
                        </div>
                        <div class="stat-number">@ViewBag.DuAnDangChay</div>
                        <div class="stat-label">Dự Án Đang Chạy</div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6">
                    <div class="stat-card red">
                        <div class="stat-icon">
                            <i class="fas fa-dollar-sign"></i>
                        </div>
                        <div class="stat-number">@ViewBag.NganSach</div>
                        <div class="stat-label">Ngân Sách</div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="quick-actions">
                <button class="action-btn">
                    <i class="fas fa-user-plus me-2"></i>Thêm Thành Viên
                </button>
                <button class="action-btn">
                    <i class="fas fa-calendar-plus me-2"></i>Tạo Hoạt Động Mới
                </button>
                <button class="action-btn">
                    <i class="fas fa-folder-plus me-2"></i>Tạo Dự Án Mới
                </button>
                <button class="action-btn">
                    <i class="fas fa-file-alt me-2"></i>Xuất Báo Cáo
                </button>
            </div>

            <!-- Charts -->
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="chart-card">
                        <div class="chart-header">
                            <h5 class="chart-title">
                                <i class="fas fa-chart-area me-2"></i>
                                Hoạt Động Trong Năm 2025
                            </h5>
                            <select class="form-select" style="width: auto;">
                                <option>2025</option>
                                <option>2024</option>
                            </select>
                        </div>
                        <canvas id="activityChart" height="80"></canvas>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="chart-card">
                        <div class="chart-header">
                            <h5 class="chart-title">
                                <i class="fas fa-chart-pie me-2"></i>
                                Phân Bổ Thành Viên
                            </h5>
                        </div>
                        <canvas id="memberChart" height="200"></canvas>
                    </div>
                </div>
            </div>
        
                @if (ViewBag.HoatDongGanDay != null)
                {
                    @foreach (var hd in ViewBag.HoatDongGanDay)
                    {
                        <tr>
                            <td><i class="fas fa-calendar me-2 text-primary"></i>@hd.TenHd</td>
                            <td>@(hd.NgayToChuc?.ToString("dd/MM/yyyy") ?? "Chưa rõ")</td>
                            <td>@(hd.DiaDiem ?? "Chưa xác định")</td>
                            <td><span class="badge bg-primary">@hd.SoNguoiThamGia người</span></td>
                            <td>
                                @if (hd.TrangThai == "Hoàn thành")
                                {
                                    <span class="badge badge-custom bg-success">@hd.TrangThai</span>
                                }
                                else if (hd.TrangThai == "Đang chuẩn bị")
                                {
                                    <span class="badge badge-custom bg-warning">@hd.TrangThai</span>
                                }
                                else
                                {
                                    <span class="badge badge-custom bg-info">@hd.TrangThai</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-success">
                                    <i class="fas fa-edit"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
   
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
    <script src="~/js/dashboard.js"></script>
</body>
</html>
