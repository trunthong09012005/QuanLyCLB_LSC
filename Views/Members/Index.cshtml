@model IEnumerable<QuanLyCLB_LSC.Models.ThanhVien>
@{
    ViewData["Title"] = "Thành viên - CLB Kỹ Năng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/dashboard.css" />

    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
             <div class="logo-circle"> <img src="@(Url.Content("~/img/logolsc.png"))" class="logo-circle-img" /></div>
            <h5 class="mb-0">Admin</h5>
            <small>Life Skills Club</small>
        </div>

        <div class="sidebar-menu">
            <a href="@Url.Action("Index", "Dashboard")" class="menu-item" onclick="showSection('dashboard')">
                <i class="fas fa-home"></i>
                <span>Trang Chủ</span>
            </a>
            <a href="@Url.Action("Index", "Members")" class="menu-item active" onclick="showSection('members')">
                <i class="fas fa-users"></i>
                <span>Thành Viên</span>
            </a>
            <a href="@Url.Action("Index", "Activities")" class="menu-item" onclick="showSection('activities')">
                <i class="fas fa-calendar-alt"></i>
                <span>Hoạt Động</span>
            </a>
            <a href="@Url.Action("Index", "Project")" class="menu-item" onclick="showSection('projects')">
                <i class="fas fa-project-diagram"></i>
                <span>Dự Án</span>
            </a>
            <a href="@Url.Action("Index", "Finance")" class="menu-item" onclick="showSection('finance')">
                <i class="fas fa-wallet"></i>
                <span>Tài Chính</span>
            </a>
            <a href="@Url.Action("Index", "Reports")" class="menu-item" onclick="showSection('reports')">
                <i class="fas fa-chart-bar"></i>
                <span>Báo Cáo</span>
            </a>
            <a href="@Url.Action("Index", "Settings")" class="menu-item" onclick="showSection('settings')">
                <i class="fas fa-cog"></i>
                <span>Cài Đặt</span>
            </a>
            <a href="@Url.Action("Login", "Auth")" class="menu-item" onclick="logout()">
                <i class="fas fa-sign-out-alt"></i>
                <span>Đăng Xuất</span>
            </a>
        </div>
    </div>

    <div class="main-content" id="mainContent">
        <div class="top-header">
            <div>
                <button class="toggle-btn" onclick="toggleSidebar()">
                    <i class="fas fa-bars"></i>
                </button>
            </div>

            <div class="user-info">
                <div class="position-relative">
                    <i class="fas fa-bell" style="font-size: 22px; color: #667eea; cursor: pointer;"></i>
           
                </div>
                <div>
                    <div class="fw-bold">Admin</div>
                    <small class="text-muted">Quản trị viên</small>
                </div>
                <div class="user-avatar">
                    <i class="fas fa-user"></i>
                </div>
            </div>
        </div>

        <div class="dashboard-content">
            <h2 class="mb-4">
                <i class="fas fa-users me-2" style="color: var(--primary-color);"></i>
                Quản lý Thành Viên
            </h2>

            <div class="row g-4 mb-4">
                <div class="col-xl-3 col-md-6">
                    <div class="stat-card blue">
                        <div class="stat-icon">
                            <i class="fas fa-users"></i>
                        </div>
                        <div class="stat-number">@ViewBag.TongThanhVien</div>
                        <div class="stat-label">Tổng Thành Viên</div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6">
                    <div class="stat-card green">
                        <div class="stat-icon">
                            <i class="fas fa-user-check"></i>
                        </div>
                        <div class="stat-number">@ViewBag.TongTaiKhoan</div>
                        <div class="stat-label">Tài khoản đã tạo</div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6">
                    <div class="stat-card orange">
                        <div class="stat-icon">
                            <i class="fas fa-user-clock"></i>
                        </div>
                        <div class="stat-number">@ViewBag.HoatDong</div>
                        <div class="stat-label">Tài khoản hoạt động</div>
                    </div>
                </div>
            </div>

            <div class="quick-actions mb-4">
                <a class="action-btn btn btn-primary" href="@Url.Action("Create", "Members")">
                    <i class="fas fa-user-plus me-2"></i>Thêm Thành Viên
                </a>
                <a class="action-btn btn btn-outline-secondary" href="@Url.Action("Index", "Reports")" style="text-decoration: underline;">
                    <i class="fas fa-file-alt me-2"></i> Xem Báo Cáo
                </a>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <form id="memberFilterForm" method="get" class="row g-2 mb-3">
                        <div class="col-md-4">
                            <input id="memberSearch" type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo tên, email hoặc SDT" autocomplete="off" />
                        </div>
                        <div class="col-md-3">
                            <select id="cvIdSelect" name="cvId" class="form-select">
                                 <option value="">-- Lọc theo chức vụ --</option>
                                 @foreach (var cv in ViewBag.ChucVus as List<QuanLyCLB_LSC.Models.ChucVu>)
                                 {
                                     if (ViewBag.CvId == cv.MaCv)
                                     {
                                         <option value="@cv.MaCv" selected>@cv.TenCv</option>
                                     }
                                     else
                                     {
                                         <option value="@cv.MaCv">@cv.TenCv</option>
                                     }
                                 }
                             </select>
                         </div>
                         <div class="col-md-3">
                            <select id="banIdSelect" name="banId" class="form-select">
                                 <option value="">-- Lọc theo ban --</option>
                                 @foreach (var b in ViewBag.Bans as List<QuanLyCLB_LSC.Models.BanChuyenMon>)
                                 {
                                     if (ViewBag.BanId == b.MaBan)
                                     {
                                         <option value="@b.MaBan" selected>@b.TenBan</option>
                                     }
                                     else
                                     {
                                         <option value="@b.MaBan">@b.TenBan</option>
                                     }
                                 }
                             </select>
                         </div>
                        <div class="col-md-2">
                            <button id="memberSearchBtn" class="btn btn-primary">Tìm</button>
                        </div>
                        <input type="hidden" id="sortByInput" name="sortBy" value="@(ViewBag.SortBy ?? "")" />
                        <input type="hidden" id="sortDirInput" name="sortDir" value="@(ViewBag.SortDir ?? "")" />
                     </form>
 
                     <div id="dataTableCard" class="table-responsive">
                         <table class="table table-striped">
                             <thead>
                                 <tr>
                                    <th class="sortable" data-sort="matv" style="cursor:pointer"># <span class="sort-ind">@(ViewBag.SortBy=="matv"?(ViewBag.SortDir=="asc"?"▲":"▼"):"")</span></th>
                                    <th class="sortable" data-sort="hoten" style="cursor:pointer">Họ tên <span class="sort-ind">@(ViewBag.SortBy=="hoten"?(ViewBag.SortDir=="asc"?"▲":"▼"):"")</span></th>
                                    <th>Chức vụ</th>
                                    <th>Ban</th>
                                    <th class="sortable" data-sort="email" style="cursor:pointer">Email <span class="sort-ind">@(ViewBag.SortBy=="email"?(ViewBag.SortDir=="asc"?("▲"):"▼") : "")</span></th>
                                    <th class="sortable" data-sort="sdt" style="cursor:pointer">SDT <span class="sort-ind">@(ViewBag.SortBy=="sdt"?(ViewBag.SortDir=="asc"?("▲"):"▼") : "")</span></th>
                                    <th>Trạng thái</th>
                                    <th>Hành động</th>
                                 </tr>
                             </thead>
                             <tbody>
                                @{ var rowIndex = 1; }
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@rowIndex</td>
                                        <td>@item.HoTen</td>
                                        <td>@item.MaCvNavigation?.TenCv</td>
                                        <td>@item.MaBanNavigation?.TenBan</td>
                                        <td>@item.Email</td>
                                        <td>@item.Sdt</td>
                                        <td>
                                            @if (item.TrangThai == "Hoạt động")
                                            {
                                                <span class="badge bg-success">@item.TrangThai</span>
                                            }
                                            else if (item.TrangThai == "Tạm dừng")
                                            {
                                                <span class="badge bg-warning text-dark">@item.TrangThai</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@item.TrangThai</span>
                                            }
                                        </td>
                                        <td>
                                            <a class="btn btn-sm btn-info" href="@Url.Action("Details", "Members", new { id = item.MaTv })">Xem</a>
                                            <a class="btn btn-sm btn-warning ms-1" href="@Url.Action("Edit", "Members", new { id = item.MaTv })">Sửa</a>
                                            <form asp-action="DeleteConfirmed" asp-controller="Members" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@item.MaTv" />
                                                <button type="submit" class="btn btn-sm btn-danger ms-1" onclick="return confirm('Bạn có chắc muốn xóa?')">Xóa</button>
                                            </form>
                                        </td>
                                    </tr>
                                    rowIndex++;
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

        </div>
    </div>

    <script>
        // AJAX fetch and update table for Members (search/filter/sort)
        (function(){
            const searchInput = document.getElementById('memberSearch');
            const cvSelect = document.getElementById('cvIdSelect');
            const banSelect = document.getElementById('banIdSelect');
            const form = document.getElementById('memberFilterForm');
            const dataCard = document.getElementById('dataTableCard');
            const sortByInput = document.getElementById('sortByInput');
            const sortDirInput = document.getElementById('sortDirInput');

            function buildUrl() {
                const params = new URLSearchParams();
                if (searchInput && searchInput.value) params.set('search', searchInput.value);
                if (cvSelect && cvSelect.value) params.set('cvId', cvSelect.value);
                if (banSelect && banSelect.value) params.set('banId', banSelect.value);
                if (sortByInput && sortByInput.value) params.set('sortBy', sortByInput.value);
                if (sortDirInput && sortDirInput.value) params.set('sortDir', sortDirInput.value);
                return '/Members/Index?' + params.toString();
            }

            async function fetchData(){
                try{
                    const url = buildUrl();
                    const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (!res.ok) return;
                    const text = await res.text();
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(text, 'text/html');
                    const newCard = doc.getElementById('dataTableCard');
                    if (newCard && dataCard) dataCard.innerHTML = newCard.innerHTML;
                    // update URL
                    history.replaceState(null, '', url);
                }catch(e){ console.error(e); }
            }

            // debounce
            let t;
            if (searchInput) searchInput.addEventListener('input', function(){ clearTimeout(t); t=setTimeout(fetchData, 300); });
            if (cvSelect) cvSelect.addEventListener('change', fetchData);
            if (banSelect) banSelect.addEventListener('change', fetchData);

            // sortable headers in current table
            dataCard.addEventListener('click', function(e){
                const th = e.target.closest('th.sortable');
                if (!th) return;
                const key = th.getAttribute('data-sort');
                if (!key) return;
                if (sortByInput.value === key) sortDirInput.value = (sortDirInput.value === 'asc') ? 'desc' : 'asc';
                else { sortByInput.value = key; sortDirInput.value = 'asc'; }
                fetchData();
            });

            // prevent normal submit
            if (form) form.addEventListener('submit', function(e){ e.preventDefault(); fetchData(); });
        })();
    </script>
